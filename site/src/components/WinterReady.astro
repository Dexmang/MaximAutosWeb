---
/**
 * WinterReady: the car's cold weather kit as one navy row in the vehicle page header,
 * November 1 to March 31 by build date (the site rebuilds daily, so the switch flips within
 * a day). Jerry, 2026-11-07: "since winter is coming we need a better way to communicate the
 * AWD, heated seats, remote start and anything else I am not thinking of on the VDP pages."
 *
 * Data is the `winter` field build_vehicles_json.py writes into every record from the CarMax
 * option list the unit was bought with (ma_vehicles.features_json) through
 * feature_rank.winter_kit: six core features (all wheel drive, heated front seats, heated rear
 * seats, remote start, heated steering wheel, snow or lock mode) counted as the meter, plus
 * extras (ground clearance, Cold Weather Package, new tires, fog lamps) listed but not counted.
 * Only what the car has is listed, never what it lacks. A car without all wheel drive gets a
 * link to the AWD page with the count of cars that have it, so that shopper stays on the site.
 * Nothing here is typed by hand: labels come from the data, the count from vehicles.json.
 * Proposal: businesses/maxim-autos/operations/vdp-winter-ready-2026-11-07.md.
 */
import Icon from './Icon.astro';

interface WinterItem { key: string; label: string; icon: string; source: string }
interface WinterKit { have: WinterItem[]; count: number; total: number; extras: WinterItem[] }
interface Props {
  winter?: WinterKit | null;
  awdCount: number;
  class?: string;
}
const { winter, awdCount, class: className = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const month = new Date().getMonth() + 1;
const inSeason = month >= 11 || month <= 3;
const items: WinterItem[] = winter ? [...(winter.have || []), ...(winter.extras || [])] : [];
const hasAwd = !!winter && (winter.have || []).some((i) => i.key === 'awd');
const total = winter?.total || 6;
const count = winter?.count || 0;
// At least one of the six earns the row. Extras alone (fog lamps on a front wheel drive
// sedan) would read as "Winter ready 0 of 6", which sells nothing.
const show = inSeason && count > 0;
---
{show && (
  <div class={`flex flex-wrap items-center gap-x-4 gap-y-2 rounded-xl bg-navy text-white px-3.5 py-2.5 md:px-4 ${className}`} data-winter-kit={count}>
    <span class="inline-flex items-center gap-1.5 font-headline font-extrabold text-sm whitespace-nowrap">
      <Icon name="ac_unit" class="text-lg text-sky-300" fill />Winter ready
      <span class="inline-flex items-center gap-0.5 ml-1.5" aria-hidden="true">
        {Array.from({ length: total }).map((_, i) => (
          <i class={`block w-3 h-1.5 rounded-sm ${i < count ? 'bg-sky-300' : 'bg-white/20'}`}></i>
        ))}
      </span>
      <span class="text-xs font-bold text-white/80 ml-1">{count} of {total}</span>
    </span>
    <ul class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[13px] font-semibold" aria-label="Winter features on this car">
      {items.map((i) => (
        <li class="inline-flex items-center gap-1">
          <Icon name={i.icon} class="text-base text-sky-300" />{i.label}
        </li>
      ))}
    </ul>
    {!hasAwd && awdCount > 0 && (
      <a href={`${base}/used-awd-cars-skokie-il`} data-cta="vdp_header" data-cta-name="winter_awd_page"
         class="inline-flex items-center gap-1 text-xs font-bold text-sky-300 hover:text-white transition-colors whitespace-nowrap md:ml-auto">
        Need all wheel drive? {awdCount} on the lot<Icon name="chevron_right" class="text-sm" />
      </a>
    )}
  </div>
)}
