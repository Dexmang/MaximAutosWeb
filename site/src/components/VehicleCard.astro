---
import TrustPair from './TrustPair.astro';
import Icon from './Icon.astro';
import { isDcPhoto as isDcUrl, dcResize, dcWebpSrcset } from '../lib/dc-image';

interface Props {
  slug: string;
  year: number;
  make: string;
  model: string;
  trim: string;
  price: number;
  mileage: number;
  drivetrain: string;
  engine: string;
  bodyStyle: string;
  photoPath: string;
  photoPrefix: string;
  inspected: boolean;
  primaryPhotoUrl?: string;
  photos?: { exterior: number; interior: number; source: string };
  dealRating?: string;
  priceSavings?: number;
  stockNumber?: string;
  lang?: string;
  /** First card in a grid: load eagerly at high priority, it is the phone LCP (P1-11). */
  priority?: boolean;
  /**
   * Heading tag for the car name. h3 under a section h2 (home, landing pages, "More
   * Vehicles"); the inventory grid sits directly under the page h1, so it passes h2 and the
   * outline does not skip a level (accessibility repair, 2026-11-26).
   */
  headingTag?: 'h2' | 'h3';
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { slug, year, make, model, trim, price, mileage, drivetrain, engine, bodyStyle, photoPath, photoPrefix, inspected, primaryPhotoUrl, photos, dealRating, priceSavings, stockNumber, lang = 'en', priority = false, headingTag = 'h3' } = Astro.props;
const isSpanish = lang === 'es';
const Heading = headingTag;

// CarGurus price rating on the card: Good and Great only (Jerry, 2026-11-26). A "Fair Deal"
// badge sat beside the price on 9 of 13 cars and argued against it; a Fair rating now shows
// no badge at all. The vehicle page follows the same rule.
const DEAL_BADGE: Record<string, { label: string; bg: string; text: string }> = isSpanish
  ? {
      GREAT_PRICE: { label: 'Gran Oferta',   bg: '#1a9b3b', text: '#fff' },
      GOOD_PRICE:  { label: 'Buena Oferta',  bg: '#2ecc71', text: '#fff' },
    }
  : {
      GREAT_PRICE: { label: 'Great Deal', bg: '#1a9b3b', text: '#fff' },
      GOOD_PRICE:  { label: 'Good Deal',  bg: '#2ecc71', text: '#fff' },
    };

const lbl = isSpanish
  ? {
      photosComing:   'Fotos en 24 horas. Escribenos para verlo primero',
      justLanded:     'Recien llegado',
      fullyInspected: 'INSPECCIONADO',
      viewLabel:      'Ver',
      mileageTbd:     'Millaje por confirmar',
    }
  : {
      photosComing:   'Photos within 24 hrs. Text to see it first',
      justLanded:     'Just landed',
      fullyInspected: 'INSPECTED',
      viewLabel:      'View',
      mileageTbd:     'Mileage TBD',
    };
const dealBadge = dealRating ? (DEAL_BADGE[dealRating] || null) : null;
// No savings figure on the card: a "$X below" comparison is CarGurus' claim, not ours to
// restate in Maxim's own markup (R1-15). The badge label alone, attributed, stays.
const title = [year, make, model, trim].filter(Boolean).join(' ');

// AWD / 4WD gets its own badge on the photo (2026-10-11). Chicago winters make it a
// buying reason, and until now it only appeared in the gray spec line under the
// title, in whatever spelling the VIN decoder used. Stacked under INSPECTED so it
// never covers the hero overlay DealerCenter burns into photo[0].
const awdMatch = /\b(awd|4wd|4x4)\b/i.exec(drivetrain || '');
const awdLabel = awdMatch ? awdMatch[1].toUpperCase() : null;

// Use CDN URL if available, fall back to local path, or null if no valid source
const localThumb = photoPath ? `${base}/${photoPath}/thumb/${photoPrefix}-photo-exterior-maxim-autos-skokie-il-01.jpg` : null;
const photoSrc = primaryPhotoUrl || localThumb;

// Responsive variants: the DealerCenter CDN resizes on the fly via the
// /{width}/{height}/ path segments (400/300 ≈ 32KB vs 1024/768 ≈ 178KB).
// CarGurus static URLs and local thumbs are fixed-size; they get no srcset.
const isDcPhoto = photoSrc ? isDcUrl(photoSrc) : false;
const cardSrcset = isDcPhoto && photoSrc
  ? `${dcResize(photoSrc, 400, 300)} 400w, ${dcResize(photoSrc, 640, 480)} 640w, ${dcResize(photoSrc, 1024, 768)} 1024w`
  : undefined;
// The phone slot is declared as 213 px, a third of 640, although the card is about 92vw
// wide. `sizes` only steers which file the browser picks (CSS still sizes the picture), and
// with the true width a 3x phone took the 1024 px file for a 359 px card: 183 KB a card,
// 1.7 MB of the home page (site review, 2026-11-26). At 213 px a 2x or 3x phone takes the
// 640 px file, 1.8 times the card. Tablet and desktop slots are unchanged.
const cardSizes = cardSrcset ? '(min-width: 1024px) 390px, (min-width: 640px) 46vw, 213px' : undefined;
// Self hosted WebP at the same three widths, cut from the 1024/768 file at build time
// (lib/dc-image.ts). Undefined when the photo could not be confirmed; the JPG list stands.
const cardWebp = isDcPhoto && photoSrc ? await dcWebpSrcset(photoSrc) : undefined;
// If the file the browser picked fails to load (the CDN's small sizes 404 now and then),
// window.maximImgFallback in Layout swaps in this one, the size the CDN serves reliably.
const fullSrc = isDcPhoto && photoSrc ? dcResize(photoSrc, 1024, 768) : undefined;

// No monthly payment on the card (R1-03). A payment is a trigger term; on a card its
// disclosure sat 5,700 px away. The estimate lives on the VDP beside the Reg Z string.
---

<div class="vehicle-card group relative h-full bg-white overflow-hidden rounded-xl shadow-sm hover:shadow-lg transition-all duration-300" data-price={price} data-body={bodyStyle} data-mileage={mileage} data-year={year} data-stock={stockNumber}>
  <!-- Stretched link covers the full card -->
  <a href={`${base}/vehicle/${slug}`} class="absolute inset-0 z-10" aria-label={`${lbl.viewLabel} ${title}`}></a>

  {/* 4:3, the shape of the photo itself, so the whole picture shows. The fixed 192 px box
      cropped the top and bottom of every card and cut the last line of the photo's own
      overlay (Jerry, 2026-11-26: main photo shown whole). */}
  <div class="relative aspect-[4/3] overflow-hidden bg-gray-100">
    {photoSrc ? (
      <picture class="block w-full h-full">
        {cardWebp && <source type="image/webp" srcset={cardWebp} sizes={cardSizes} />}
        <img
          src={photoSrc}
          srcset={cardSrcset}
          sizes={cardSizes}
          alt={`${title} for sale at Maxim Autos Skokie IL`}
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : undefined}
          width="1024"
          height="768"
          data-full={fullSrc}
          onerror={fullSrc ? 'window.maximImgFallback&&window.maximImgFallback(this)' : undefined}
        />
      </picture>
    ) : (
      <div class="w-full h-full flex flex-col justify-between p-3 text-white"
           style="background: radial-gradient(120% 90% at 100% 0%, rgba(240,128,16,.28) 0%, rgba(240,128,16,0) 55%), linear-gradient(160deg, #0a2540 0%, #061a2e 100%);">
        <div class="font-headline font-bold text-[11px] tracking-[0.18em] uppercase text-orange-light">{lbl.justLanded}</div>
        <div class="font-headline font-extrabold text-xl leading-tight">{year} {make}<br />{model} {trim}</div>
        <div class="text-[11px] font-medium opacity-85">{lbl.photosComing}</div>
      </div>
    )}
    {/* Top centre since 2026-11-26. The card now shows the whole photo, and the photo's own
        overlay fills every corner: feature pills top left, the Maxim logo top right, the fee
        line and phone bottom left, CARFAX and the rating bottom right. At top right these two
        badges sat on the logo. The strip of sky between the pills and the logo is free. */}
    {(inspected || awdLabel) && (
      <div class="absolute top-2 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1">
        {inspected && (
          <div class="bg-navy text-white text-xs font-bold px-2.5 py-1 rounded-md flex items-center gap-1">
            <Icon name="check_circle" class="text-xs" fill />
            {lbl.fullyInspected}
          </div>
        )}
        {awdLabel && (
          <div class="bg-white text-navy text-xs font-bold px-2.5 py-1 rounded-md flex items-center gap-1 shadow-sm">
            <Icon name="ac_unit" class="text-xs" fill />
            {awdLabel}
          </div>
        )}
      </div>
    )}
  </div>
  <div class="px-3 py-4 sm:px-4">
    <Heading class="font-headline text-base font-bold text-gray-900 mb-0.5">{title}</Heading>
    <p class="text-xs text-gray-500 mb-2.5 flex justify-between items-baseline gap-2">
      <span>{[engine, drivetrain, mileage > 0 ? `${mileage.toLocaleString()} mi` : lbl.mileageTbd].filter(Boolean).join(' • ')}</span>
      {stockNumber && <span class="shrink-0 text-gray-500 font-medium whitespace-nowrap">Stock #{stockNumber}</span>}
    </p>

    <!-- Price, with the fee promise as the price's own label. No card payment (R1-03). -->
    <div class="flex justify-between items-baseline gap-2">
      <span class="text-xl font-extrabold text-navy">${price.toLocaleString()}</span>
      <TrustPair variant="fee" lang={lang} />
    </div>
    {/* The CarGurus deal rating, when the car has one. No CARFAX label or link on a card: the
        report shows on the car page only (Jerry, 2026-11-27). */}
    {dealBadge && (
      <div class="flex items-center mt-2 min-h-[24px]">
        <span class="inline-flex items-center gap-1">
          <span class="text-xs font-bold px-2 py-0.5 rounded" style={`background:${dealBadge.bg};color:${dealBadge.text}`}>{dealBadge.label}</span>
          <span class="text-xs text-gray-500 font-medium">CarGurus</span>
        </span>
      </div>
    )}
  </div>
</div>
