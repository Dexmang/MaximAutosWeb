---
import TrustPair from './TrustPair.astro';
import Icon from './Icon.astro';

interface Props {
  slug: string;
  year: number;
  make: string;
  model: string;
  trim: string;
  price: number;
  mileage: number;
  drivetrain: string;
  engine: string;
  bodyStyle: string;
  photoPath: string;
  photoPrefix: string;
  inspected: boolean;
  primaryPhotoUrl?: string;
  photos?: { exterior: number; interior: number; source: string };
  dealRating?: string;
  priceSavings?: number;
  stockNumber?: string;
  lang?: string;
  /** First card in a grid: load eagerly at high priority, it is the phone LCP (P1-11). */
  priority?: boolean;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { slug, year, make, model, trim, price, mileage, drivetrain, engine, bodyStyle, photoPath, photoPrefix, inspected, primaryPhotoUrl, photos, dealRating, priceSavings, stockNumber, lang = 'en', priority = false } = Astro.props;
const isSpanish = lang === 'es';

const DEAL_BADGE: Record<string, { label: string; bg: string; text: string }> = isSpanish
  ? {
      GREAT_PRICE: { label: 'Gran Oferta',   bg: '#1a9b3b', text: '#fff' },
      GOOD_PRICE:  { label: 'Buena Oferta',  bg: '#2ecc71', text: '#fff' },
      FAIR_PRICE:  { label: 'Oferta Justa',  bg: '#3498db', text: '#fff' },
    }
  : {
      GREAT_PRICE: { label: 'Great Deal', bg: '#1a9b3b', text: '#fff' },
      GOOD_PRICE:  { label: 'Good Deal',  bg: '#2ecc71', text: '#fff' },
      FAIR_PRICE:  { label: 'Fair Deal',  bg: '#3498db', text: '#fff' },
    };

const lbl = isSpanish
  ? {
      freeCarfax:     'CARFAX Gratis',
      photosComing:   'Fotos en 24 horas. Escribenos para verlo primero',
      justLanded:     'Recien llegado',
      fullyInspected: 'INSPECCIONADO',
      viewLabel:      'Ver',
      mileageTbd:     'Millaje por confirmar',
    }
  : {
      freeCarfax:     'Free CARFAX',
      photosComing:   'Photos within 24 hrs. Text to see it first',
      justLanded:     'Just landed',
      fullyInspected: 'INSPECTED',
      viewLabel:      'View',
      mileageTbd:     'Mileage TBD',
    };
const dealBadge = dealRating ? (DEAL_BADGE[dealRating] || null) : null;
// No savings figure on the card: a "$X below" comparison is CarGurus' claim, not ours to
// restate in Maxim's own markup (R1-15). The badge label alone, attributed, stays.
const title = [year, make, model, trim].filter(Boolean).join(' ');

// Use CDN URL if available, fall back to local path, or null if no valid source
const localThumb = photoPath ? `${base}/${photoPath}/thumb/${photoPrefix}-photo-exterior-maxim-autos-skokie-il-01.jpg` : null;
const photoSrc = primaryPhotoUrl || localThumb;

// Responsive variants: the DealerCenter CDN resizes on the fly via the
// /{width}/{height}/ path segments (400/300 ≈ 32KB vs 1024/768 ≈ 178KB).
// CarGurus static URLs and local thumbs are fixed-size; they get no srcset.
const DC_DIMS_RE = /\/(\d{2,4})\/(\d{2,4})\//;
const isDcPhoto = photoSrc ? (photoSrc.includes('dealercenter.net') && DC_DIMS_RE.test(photoSrc)) : false;
const dcResize = (u: string, w: number, h: number) => u.replace(DC_DIMS_RE, `/${w}/${h}/`);
const cardSrcset = isDcPhoto && photoSrc
  ? `${dcResize(photoSrc, 400, 300)} 400w, ${dcResize(photoSrc, 640, 480)} 640w, ${dcResize(photoSrc, 1024, 768)} 1024w`
  : undefined;
const cardSizes = cardSrcset ? '(min-width: 1024px) 390px, (min-width: 640px) 46vw, 92vw' : undefined;

// No monthly payment on the card (R1-03). A payment is a trigger term; on a card its
// disclosure sat 5,700 px away. The estimate lives on the VDP beside the Reg Z string.
---

<div class="vehicle-card group relative bg-white overflow-hidden rounded-xl shadow-sm hover:shadow-lg transition-all duration-300" data-price={price} data-body={bodyStyle} data-mileage={mileage} data-year={year} data-stock={stockNumber}>
  <!-- Stretched link covers the full card -->
  <a href={`${base}/vehicle/${slug}`} class="absolute inset-0 z-10" aria-label={`${lbl.viewLabel} ${title}`}></a>

  <div class="relative h-48 overflow-hidden bg-gray-100">
    {photoSrc ? (
      <img
        src={photoSrc}
        srcset={cardSrcset}
        sizes={cardSizes}
        alt={`${title} for sale at Maxim Autos Skokie IL`}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        width="1024"
        height="768"
      />
    ) : (
      <div class="w-full h-full flex flex-col justify-between p-3 text-white"
           style="background: radial-gradient(120% 90% at 100% 0%, rgba(240,128,16,.28) 0%, rgba(240,128,16,0) 55%), linear-gradient(160deg, #0a2540 0%, #061a2e 100%);">
        <div class="font-headline font-bold text-[11px] tracking-[0.18em] uppercase text-orange-light">{lbl.justLanded}</div>
        <div class="font-headline font-extrabold text-xl leading-tight">{year} {make}<br />{model} {trim}</div>
        <div class="text-[11px] font-medium opacity-85">{lbl.photosComing}</div>
      </div>
    )}
    {inspected && (
      <div class="absolute top-2 right-2 bg-navy text-white text-xs font-bold px-2.5 py-1 rounded-md flex items-center gap-1">
        <Icon name="check_circle" class="text-xs" fill />
        {lbl.fullyInspected}
      </div>
    )}
  </div>
  <div class="px-3 py-4 sm:px-4">
    <h3 class="font-headline text-base font-bold text-gray-900 mb-0.5">{title}</h3>
    <p class="text-xs text-gray-500 mb-2.5 flex justify-between items-baseline gap-2">
      <span>{[engine, drivetrain, mileage > 0 ? `${mileage.toLocaleString()} mi` : lbl.mileageTbd].filter(Boolean).join(' • ')}</span>
      {stockNumber && <span class="shrink-0 text-gray-500 font-medium whitespace-nowrap">Stock #{stockNumber}</span>}
    </p>

    <!-- Price, with the fee promise as the price's own label. No card payment (R1-03). -->
    <div class="flex justify-between items-baseline gap-2">
      <span class="text-xl font-extrabold text-navy">${price.toLocaleString()}</span>
      <TrustPair variant="fee" lang={lang} />
    </div>
    <div class="flex justify-between items-center mt-2 min-h-[24px]">
      {dealBadge ? (
        <span class="inline-flex items-center gap-1">
          <span class="text-xs font-bold px-2 py-0.5 rounded" style={`background:${dealBadge.bg};color:${dealBadge.text}`}>{dealBadge.label}</span>
          <span class="text-xs text-gray-500 font-medium">CarGurus</span>
        </span>
      ) : <span></span>}
      <span class="inline-flex items-center gap-1 text-xs bg-gray-100 text-gray-600 px-2 py-1 rounded-full font-medium">
        <Icon name="description" class="text-xs" fill />
        {lbl.freeCarfax}
      </span>
    </div>
  </div>
</div>
