---
/**
 * PriceVoices: genuine reviews that talk about the price, shown beside the promise.
 *
 * Research verdict of 2026-10-13 (otd-prominence-check, Approach 2 table): go. Rules:
 *  - every quote is a review from reviews.json, verbatim, never trimmed or paraphrased;
 *  - attribution comes from each review's own `source` field (guardrail A9): "Google
 *    review", "Cars.com review"; never a platform label typed here, never a logo for a
 *    non Google review;
 *  - reviewers on the publication denylist (reviews-excluded.json) never render here,
 *    whatever the lint rule would catch later;
 *  - no Review JSON-LD from this component (the pages that emit it filter to Google).
 * Selection is by keyword so a new review about the price appears on the next build
 * without anyone editing a list.
 */
import reviews from '../data/reviews.json';
import excluded from '../data/reviews-excluded.json';

interface Props { lang?: 'en' | 'es'; class?: string; max?: number }
const { lang = 'en', class: className = '', max = 4 } = Astro.props;
const es = lang === 'es';

const deny = new Set<string>();
for (const e of (excluded as any).excluded || []) {
  deny.add(String(e.name).toLowerCase());
  for (const a of e.aliases || []) deny.add(String(a).toLowerCase());
}
const aboutPrice = /\b(fee|fees|price|prices|pricing|surprise|surprises|honest|transparent|hidden|cost|straightforward|pressure)\b/i;
const picks = (reviews as any[])
  .filter(r => r.text && r.source && r.rating && !deny.has(String(r.name).toLowerCase()))
  .filter(r => aboutPrice.test(r.text))
  .slice(0, max);

const t = es
  ? { kicker: 'En sus propias palabras', h2: 'Lo que dicen los compradores sobre el precio', review: 'resena en' }
  : { kicker: 'In their own words', h2: 'What buyers say about the price', review: 'review on' };
const stars = (n: number) => '★'.repeat(Math.max(0, Math.min(5, Math.round(n)))) + '☆'.repeat(5 - Math.max(0, Math.min(5, Math.round(n))));
---
{picks.length > 0 && (
  <section class={`py-12 lg:py-14 bg-white ${className}`} id="price-voices">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <span class="text-orange font-bold uppercase tracking-widest text-sm mb-2 block">{t.kicker}</span>
      <h2 class="font-headline text-2xl md:text-3xl font-extrabold text-navy mb-6">{t.h2}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {picks.map(r => (
          <figure class="bg-surface rounded-xl border border-gray-100 p-5">
            <div class="text-orange text-sm tracking-wider" aria-label={`${r.rating} of 5`}>{stars(Number(r.rating))}</div>
            <blockquote class="text-gray-700 leading-relaxed mt-2">{r.text}</blockquote>
            <figcaption class="text-xs text-gray-500 mt-3"><span class="font-semibold text-gray-700">{r.name}</span>, {t.review} {r.source}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
