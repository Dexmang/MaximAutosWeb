---
/**
 * CarfaxButton: the "SHOW ME THE CARFAX" report row on the vehicle page. It opens the car's
 * free CARFAX report in a new tab and sits right under the name, price and facts line, one of
 * the first pieces of information on the page (Jerry, 2026-11-27).
 *
 * VEHICLE PAGE ONLY. Jerry, 2026-11-27: the report link shows on the car page and nowhere a
 * car is listed (inventory, home, landing pages). Do not put this on VehicleCard, which
 * carries no CARFAX label or link at all.
 *
 * The design is the "report row" Jerry picked from three options the same day: a soft panel,
 * a report icon, "SHOW ME THE" in the orange ink beside the black tile wordmark (his lockup
 * from 2026-10-15), one plain line under it, and a chevron.
 *
 * NARROW PHONES. The top line cannot wrap, so the row has a minimum width. Under 390 px the
 * icon, type and tiles step down a size; under 340 px the icon box goes. An earlier version
 * was 357 px wide at every width and pushed the page sideways on a 360 px phone. Any change
 * here is checked at 320, 360, 375, 390 and 412 px.
 *
 * No VIN, or the links switched off: a plain "Free CARFAX" label, never a dead link.
 */
import Icon from './Icon.astro';
import { carfaxUrl } from '../lib/carfax';

interface Props {
  vin?: string;
  /** "2015 Nissan Murano Platinum", for the accessible name */
  title: string;
  /** data-cta value for GA4 */
  cta: string;
  lang?: string;
  class?: string;
}
const { vin, title, cta, lang = 'en', class: cls = '' } = Astro.props;
const href = carfaxUrl(vin);
const es = lang === 'es';
const tile = 'bg-black text-white font-black leading-none flex justify-center rounded-[2px] w-[17px] h-[17px] text-[12px] max-[389px]:w-[15px] max-[389px]:h-[15px] max-[389px]:text-[10.5px]';
---
{href ? (
  <a href={href} target="_blank" rel="noopener noreferrer" data-cta={cta} data-cta-name="carfax"
     aria-label={es ? `Ver el reporte CARFAX gratis de este ${title}` : `Show me the free CARFAX report for this ${title}`}
     class:list={[
       'flex items-center gap-3 max-[389px]:gap-2.5 w-full max-w-[440px] rounded-xl border border-[#dbe3ec] bg-[#f3f6fa] hover:bg-[#e9eff6] hover:border-[#c5d1de] transition-colors px-3 max-[389px]:px-2.5 py-2.5 text-navy',
       cls,
     ]}>
    <span class="max-[339px]:hidden flex items-center justify-center w-10 h-10 max-[389px]:w-9 max-[389px]:h-9 rounded-[10px] bg-white border border-[#dbe3ec] shrink-0">
      <Icon name="task" class="text-[22px] text-navy" />
    </span>
    <span class="flex-1 min-w-0">
      <span class="flex items-center gap-2 max-[389px]:gap-1.5 whitespace-nowrap">
        <span class="font-headline font-extrabold tracking-[0.04em] text-orange-ink leading-none text-[13px] max-[389px]:text-[12px]">{es ? 'VER EL' : 'SHOW ME THE'}</span>
        <span class="flex gap-[2px]" aria-hidden="true">
          {'CARFA'.split('').map(ch => <span class={`${tile} items-center`}>{ch}</span>)}
          <span class={`${tile} items-end pb-[2px]`}>x</span>
        </span>
      </span>
      <span class="block text-[13px] leading-tight text-gray-600 mt-1.5">{es ? 'Reporte de historial gratis' : 'Free vehicle history report'}</span>
    </span>
    <Icon name="chevron_right" class="text-[20px] text-slate-500" />
  </a>
) : (
  <span class:list={['inline-flex items-center gap-1 text-xs bg-gray-100 text-gray-600 px-2 py-1 rounded-full font-medium', cls]}>
    {es ? 'CARFAX Gratis' : 'Free CARFAX'}
  </span>
)}
