---
// The rating chip reads facts.json through TrustPair. Never type a rating or a count here.
import TrustPair from './TrustPair.astro';
import Icon from './Icon.astro';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname;

// Build the language switcher target URL
// currentPath includes the base prefix in non-Vercel builds, so strip it first
const isSpanish = lang === 'es';
const pathWithoutBase = base ? currentPath.replace(base, '') : currentPath;
const langSwitcherHref = isSpanish
  ? (() => {
      // Strip /es/ prefix to get the Spanish slug (e.g. /es/inventario -> inventario)
      const slug = pathWithoutBase.replace(/^\/es\/?/, '').replace(/\/$/, '');
      const esToEn: Record<string, string> = {
        'inventario': 'inventory',
        'sobre-nosotros': 'about',
        'contacto': 'contact',
        'financiamiento': 'financing',
        'aplicacion-de-credito': 'apply',
        'vender-intercambiar': 'sell-trade',
        'compra-en-linea': 'ship',
      };
      const enSlug = esToEn[slug];
      return enSlug ? `${base}/${enSlug}` : `${base}/`;
    })()
  : (() => {
      // Strip leading/trailing slashes to get the English slug (e.g. /inventory -> inventory)
      const slug = pathWithoutBase.replace(/^\//, '').replace(/\/$/, '');
      const enToEs: Record<string, string> = {
        'inventory': 'inventario',
        'about': 'sobre-nosotros',
        'contact': 'contacto',
        'financing': 'financiamiento',
        'apply': 'aplicacion-de-credito',
        'sell-trade': 'vender-intercambiar',
        'ship': 'compra-en-linea',
      };
      const esSlug = enToEs[slug];
      // Spanish home is /es with no trailing slash: /es/ answers with a 308 (D2-14a)
      return esSlug ? `${base}/es/${esSlug}` : `${base}/es`;
    })();
const langSwitcherLabel = isSpanish ? 'English' : 'Español';

// Primary desktop nav, kept lean
const primaryLinks = isSpanish
  ? [
      { href: `${base}/es/inventario`, label: 'Inventario' },
      { href: `${base}/es/financiamiento`, label: 'Financiamiento' },
      { href: `${base}/es/vender-intercambiar`, label: 'Vender / Cambiar' },
      { href: `${base}/es/compra-en-linea`, label: 'Entrega a Domicilio' },
      { href: `${base}/es/sobre-nosotros`, label: 'Nosotros' },
    ]
  : [
      { href: `${base}/inventory`, label: 'Inventory' },
      { href: `${base}/financing`, label: 'Financing' },
      { href: `${base}/sell-trade`, label: 'Sell / Trade' },
      { href: `${base}/ship`, label: 'Delivered Anywhere' },
      { href: `${base}/about`, label: 'About' },
    ];

// Secondary links shown only in mobile menu + secondary bar
const secondaryLinks = isSpanish
  ? [
      { href: `${base}/testimonials`, label: 'Reseñas' },
      { href: `${base}/faq`, label: 'Preguntas' },
      { href: `${base}/es/contacto`, label: 'Contacto' },
    ]
  : [
      { href: `${base}/testimonials`, label: 'Reviews' },
      { href: `${base}/faq`, label: 'FAQ' },
      { href: `${base}/contact`, label: 'Contact' },
    ];

const directionsUrl = 'https://www.google.com/search?q=Maxim+Autos+9101+Terminal+Ave+Skokie+IL+60077+directions';

// Full credit application, surfaced in the header chrome on every page
const applyHref = isSpanish ? `${base}/es/aplicacion-de-credito` : `${base}/apply`;

const chrome = isSpanish
  ? {
      directions: 'Direcciones',
      textJerry: 'Escribe a Jerry',
      callOrText: 'Llama o Escribe',
      applyFull: 'Solicitud Completa de Credito',
      directionsAria: 'Obtener direcciones a Maxim Autos',
      toggleMenuAria: 'Abrir menu',
      directionsMobile: 'Direcciones, 9101 Terminal Ave, Skokie IL',
    }
  : {
      directions: 'Directions',
      textJerry: 'Text Jerry',
      callOrText: 'Call or Text',
      applyFull: 'Full Credit Application',
      directionsAria: 'Get directions to Maxim Autos',
      toggleMenuAria: 'Toggle menu',
      directionsMobile: 'Directions, 9101 Terminal Ave, Skokie IL',
    };
---

<!-- Secondary utility bar, desktop only -->
<div class="hidden lg:block bg-gray-50 border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 flex justify-end items-center gap-5 py-1.5">
    <!-- Full credit application CTA. Lives here, not in the main nav bar: the main
         bar's natural content is already wider than max-w-7xl allows, so any button
         added there wraps the phone box and nav links onto two lines. This strip has
         the room, and mr-auto anchors the pill to the otherwise empty left side. -->
    <a href={applyHref}
       class="mr-auto inline-flex items-center gap-1 bg-orange text-white text-xs font-bold px-3 py-1 rounded-full hover:bg-orange-dark transition-colors">
      <Icon name="payments" class="text-sm" fill />
      {chrome.applyFull}
    </a>
    {secondaryLinks.map(link => (
      <a href={link.href}
         class:list={['text-xs font-medium transition-colors', currentPath.startsWith(link.href) ? 'text-navy' : 'text-gray-400 hover:text-navy']}>
        {link.label}
      </a>
    ))}
    <a href={directionsUrl} target="_blank" rel="noopener"
       class="flex items-center gap-1 text-xs font-medium text-gray-400 hover:text-navy transition-colors">
      <Icon name="location_on" class="text-sm" fill />
      9101 Terminal Ave, Skokie IL
    </a>
    <span class="text-gray-300 text-xs">|</span>
    <a href={langSwitcherHref}
       class="text-xs font-semibold text-gray-400 hover:text-navy transition-colors"
       aria-label={isSpanish ? 'Switch to English' : 'Cambiar a Español'}>
      {langSwitcherLabel}
    </a>
  </div>
</div>

<nav class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-100">
  <!-- Phones: 44 px chip and menu button plus py-1.5 make a 57 px header (was 80).
       lg keeps py-3 so the desktop header does not grow (R2-03). -->
  <div class="flex justify-between items-center w-full px-4 sm:px-6 lg:px-8 py-1.5 lg:py-3 max-w-7xl mx-auto">
    <!-- Logo + Rating -->
    <div class="flex items-center gap-2 sm:gap-4 shrink-0">
      <a href={`${base}/`}>
        <img src={`${base}/brand/logo-header.png`} alt="Maxim Autos" width="248" height="60" class="h-8 sm:h-9 md:h-10 w-auto" />
      </a>
      <TrustPair variant="chip" lang={lang} />
      <!-- CARFAX shield from 640 up. Below that its width goes to legible rating type. -->
      <img src={`${base}/brand/carfax/advantage-dealer.png`} alt="CARFAX Advantage Dealer"
           width="714" height="525"
           class="hidden sm:block h-9 md:h-10 w-auto shrink-0" loading="eager" />
    </div>

    <!-- Desktop Nav -->
    <div class="hidden lg:flex items-center gap-6">
      {primaryLinks.map(link => (
        <a
          href={link.href}
          class:list={[
            'text-sm font-medium transition-colors duration-200',
            currentPath.startsWith(link.href)
              ? 'text-navy border-b-2 border-orange pb-1'
              : 'text-gray-500 hover:text-navy',
          ]}
        >
          {link.label}
        </a>
      ))}
      <a href={directionsUrl} target="_blank" rel="noopener"
         class="flex items-center gap-1 text-sm font-medium text-gray-500 hover:text-navy transition-colors duration-200">
        <Icon name="location_on" class="text-base" fill />
        {chrome.directions}
      </a>
    </div>

    <!-- CTA + Mobile Toggle -->
    <div class="flex items-center gap-2">
      <!-- Mobile/tablet: clickable Text button -->
      <a
        href={`sms:8475108947&body=${encodeURIComponent(isSpanish ? 'Hola Jerry, me interesa un auto de Maxim Autos.' : "Hi Jerry, I'm interested in a vehicle at Maxim Autos.")}`}
        data-cta="header"
        class="sm:inline-flex lg:hidden items-center gap-1.5 bg-orange text-white px-3 py-2 rounded-lg font-bold text-sm hover:bg-orange-dark transition-colors hidden"
      >
        <Icon name="sms" class="text-base" fill />
        {chrome.textJerry}
      </a>
      <!-- Desktop: non-clickable phone display -->
      <div class="hidden lg:flex items-center gap-2 bg-surface border border-gray-200 rounded-lg px-3 py-2">
        <Icon name="phone" class="text-base text-navy" fill />
        <div class="leading-none">
          <p class="text-sm font-bold text-navy leading-none">(847) 510-8947</p>
          <p class="text-xs text-gray-400 mt-0.5">{chrome.callOrText}</p>
        </div>
      </div>
      <!-- Tablet: directions icon, links to Google Maps pin. Hidden on phones:
           the bottom tab bar covers Directions there and the row needs the width
           for the rating chip. -->
      <a href={directionsUrl} target="_blank" rel="noopener"
         class="hidden sm:flex lg:hidden items-center p-2 text-gray-500 hover:text-orange transition-colors"
         aria-label={chrome.directionsAria}>
        <Icon name="location_on" class="text-2xl" fill />
      </a>
      <!-- Mobile menu button. 44 x 44 tap target; the old p-2 plus text-3xl button was 46 x 55 and set the
           phone header at 80 px. -mr-1.5 lines the glyph up with the gutter. -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden w-11 h-11 -mr-1.5 flex items-center justify-center text-gray-600 hover:text-navy"
        aria-label={chrome.toggleMenuAria}
      >
        <Icon name="menu" class="text-[28px] leading-none" />
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-white border-t border-gray-100 pb-4">
    <div class="px-6 py-2 space-y-1">
      <a href={applyHref}
         class="flex items-center justify-center gap-2 bg-orange text-white py-3 px-4 rounded-lg text-sm font-bold hover:bg-orange-dark transition-colors mb-2">
        <Icon name="payments" class="text-base" fill />
        {chrome.applyFull}
      </a>
      {[...primaryLinks, ...secondaryLinks].map(link => (
        <a
          href={link.href}
          class:list={[
            'block py-3 px-4 rounded-lg text-sm font-medium',
            currentPath.startsWith(link.href)
              ? 'bg-navy/5 text-navy'
              : 'text-gray-600 hover:bg-gray-50',
          ]}
        >
          {link.label}
        </a>
      ))}
      <a href={directionsUrl} target="_blank" rel="noopener"
         class="flex items-center gap-2 py-3 px-4 rounded-lg text-sm font-medium text-gray-600 hover:bg-gray-50">
        <Icon name="location_on" class="text-base text-orange" fill />
        {chrome.directionsMobile}
      </a>
      <a href={langSwitcherHref}
         class="flex items-center gap-2 py-3 px-4 rounded-lg text-sm font-semibold text-gray-600 hover:bg-gray-50 border-t border-gray-100 mt-1 pt-4">
        <Icon name="language" class="text-base text-gray-400" />
        {langSwitcherLabel}
      </a>
    </div>
  </div>
</nav>

<script is:inline>
  var mobileMenu = document.getElementById('mobile-menu');
  document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
  mobileMenu?.querySelectorAll('a').forEach(function(link) {
    link.addEventListener('click', function() {
      mobileMenu.classList.add('hidden');
    });
  });
</script>
