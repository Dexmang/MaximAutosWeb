---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import VehicleCard from '../components/VehicleCard.astro';
import PriceBandNote from '../components/PriceBandNote.astro';
import ReviewRotator from '../components/ReviewRotator.astro';
import Icon from '../components/Icon.astro';
import vehicles from '../data/vehicles.json';
import reviews from '../data/reviews.json';
import reviewsMeta from '../data/reviews_meta.json';
import suburbs from '../data/suburbs.json';

import facts from '../data/facts.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Title 52 characters; description 153 today, 155 at the worst case band (D2-01, D2-02).
// Every number comes from facts.json. The meta description is one of the two surfaces
// allowed to carry the live band alone (D6), so no segment claim appears here.
const title = 'Used Cars in Skokie IL, No Dealer Fees | Maxim Autos';
const description = `${facts.reviews.ratingText} from ${facts.reviews.count} reviews. No dealer fees, ever. ${facts.inventory.stockLineText}, in Skokie, IL. Metal plates issued the same visit.`;
const featured = vehicles.filter(v => (v as any).status !== 'sold');
// Non-Google platforms present in the review set. Drives the review-grid source
// label, which is only shown when the cards are NOT all Google (otherwise the
// "Stars on Google" heading already says it).
const offGoogleSources = [...new Set(reviews.filter(r => r.source !== 'Google').map(r => r.source))];
// The hero rotators take a subset; the full set would put a dot row too long to
// tap under a 288px card. reviews.json is ordered newest first.
const heroReviews = reviews.slice(0, 6);
---

<Layout
  title={title}
  description={description}
  hreflangEn="https://www.maximautos.com/"
  hreflangEs="https://www.maximautos.com/es"
>
  <Fragment slot="structured-data">
    {reviews.filter(r => r.source === 'Google').slice(0, 3).map(r => (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Review",
        "itemReviewed": {
          "@type": "AutoDealer",
          "name": "Maxim Autos",
          "url": "https://www.maximautos.com"
        },
        "author": { "@type": "Person", "name": r.name },
        "reviewBody": r.text,
        "reviewRating": { "@type": "Rating", "ratingValue": String(r.rating), "bestRating": "5" },
        "datePublished": r.date
      })} />
    ))}
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AutoDealer",
      "name": "Maxim Autos",
      "logo": "https://www.maximautos.com/brand/logo-512.png",
      "sameAs": [
        "https://www.google.com/maps/place/Maxim+Autos/@42.0464352,-87.7546134,17z/data=!3m1!4b1!4m6!3m5!1s0x880fcfcb0a430aed:0x4d36c77af06ce602!8m2!3d42.0464352!4d-87.7546134!16s%2Fg%2F11wmzx_p4t",
        "https://www.mapquest.com/us/illinois/maxim-autos-814974890"
      ],
      "description": description,
      "url": "https://www.maximautos.com",
      "telephone": "+1-847-510-8947",
      "email": "jfranco@maximautos.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "9101 Terminal Ave",
        "addressLocality": "Skokie",
        "addressRegion": "IL",
        "postalCode": "60077",
        "addressCountry": "US"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 42.0464352,
        "longitude": -87.7546134
      },
      "openingHoursSpecification": [
        { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Thursday","Friday"], "opens": "15:00", "closes": "19:00" },
        { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "10:00", "closes": "15:00" }
      ],
      "priceRange": facts.inventory.priceRange,
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": String(reviewsMeta.rating.toFixed(1)),
        "reviewCount": String(reviewsMeta.count),
        "bestRating": "5"
      },
      "areaServed": [
        { "@type": "City", "name": "Skokie" },
        { "@type": "City", "name": "Evanston" },
        { "@type": "City", "name": "Niles" },
        { "@type": "City", "name": "Morton Grove" },
        { "@type": "City", "name": "Lincolnwood" },
        { "@type": "City", "name": "Des Plaines" },
        { "@type": "City", "name": "Wilmette" },
        { "@type": "City", "name": "Glenview" }
      ]
    })} />
  </Fragment>

  <Header slot="header" />

  <!-- Hero -->
  <section class="bg-navy overflow-hidden md:relative md:min-h-[224px] lg:min-h-[256px] md:flex md:items-center">
    <!-- Hero photo, md and up only. Below md it was 112 px of stock photo ahead of the
         first car (D1-09). A hidden wrapper alone does not stop an eager img downloading,
         so phones match a 1x1 inline gif source instead and never fetch the 108,944 byte
         photo (D1-10). The img carries its own aspect ratio so the swap cannot shift. -->
    <div class="hidden md:block relative w-full overflow-hidden md:overflow-visible md:absolute md:inset-0 md:z-0">
      <picture>
        <source media="(max-width: 767px)" srcset="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" width="1" height="1" />
        <source media="(min-width: 768px)" srcset={`${base}/brand/hero-family.webp`} type="image/webp" width="1024" height="572" />
        <img
          src={`${base}/brand/hero-family.jpg`}
          alt="Family enjoying their car purchased from Maxim Autos in Skokie IL"
          width="1024"
          height="572"
          class="w-full h-auto md:h-full md:object-cover md:object-center"
          style="aspect-ratio:1024/572"
          loading="eager"
          fetchpriority="high"
        />
      </picture>
      <!-- Desktop: left to right overlay -->
      <div class="hidden md:block absolute inset-0 bg-gradient-to-r from-navy/90 via-navy/70 to-navy/20"></div>

      <!-- Rotating review card, lower right, lg and up only. At 768 the hero text ran under
           it and hid the tax, title and license clause (R2-07). Phones get a static Google
           review after the second car instead. -->
      <ReviewRotator reviews={heroReviews} class="hidden lg:block absolute bottom-4 right-6 lg:bottom-5 lg:right-8 w-64 lg:w-72" />
    </div>

    <div class="relative z-10 w-full max-w-7xl mx-auto px-6 lg:px-8 pt-4 pb-4 md:py-5">
      <div class="max-w-xl md:max-w-2xl">
        {/* Rating badge, md and up. On phones the pinned header chip already carries the
            rating, so a second copy here only pushed the first car down (D1-11). */}
        <a href="https://www.google.com/search?q=Maxim+Autos+Skokie+IL+reviews" target="_blank" rel="noopener"
           data-cta="hero" data-cta-name="google_reviews"
           class="hidden md:inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 text-white rounded-full px-3 py-1 mb-2 hover:bg-white/20 transition-colors">
          <Icon name="star" class="text-orange text-sm" fill />
          <span class="font-bold text-sm">{facts.reviews.ratingValue} Stars on Google</span>
          <span class="text-white/60 text-xs">· {facts.reviews.count} Reviews</span>
        </a>
        <h1 class="font-headline text-2xl md:text-3xl lg:text-4xl font-extrabold text-white leading-tight tracking-tight mb-1">
          Used Cars in Skokie, IL
        </h1>
        <p class="hidden md:block font-headline text-base md:text-lg lg:text-xl font-bold text-white mb-1">No Dealer Fees Ever.</p>
        {/* Segment sentence, md and up. Phones show the live band note alone, which D6
            permits; on desktop the pair stays adjacent (D1-14). */}
        <p class="hidden md:block text-sm md:text-base text-white/80 mb-1 leading-snug text-balance">
          Specializing in the {facts.inventory.segmentText} range, hand picked cars only. Drive home the same day.
        </p>
        {/* The segment claim above is only defensible with the real current range beside
            it, so this note is not optional decoration. See PriceBandNote.astro, and
            the unpaired-segment-band rule in scripts/lint-copy.mjs which fails the build
            gate if the two ever get separated. */}
        <PriceBandNote class="text-white mb-3 max-w-lg md:max-w-2xl" />
        <div class="flex flex-wrap gap-2 mt-3 mb-3">
          {/* These chips pointed at /inventory?price=under10k and ?body=SUV.
              Why they were repointed at the landing pages instead:
                1. robots.txt carries `Disallow: /inventory?`, so the homepage was linking
                   crawlers straight into URLs the site itself blocks.
                2. The landing pages had ZERO inbound internal links from anywhere, which
                   is why 28 URLs sit in Search Console as "Discovered, currently not
                   indexed". These chips now carry real internal link signal to three.

              CORRECTION, 2026-07-26: an earlier version of this comment claimed
              inventory.astro does not read query params and that the chips therefore
              served an unfiltered list. That was WRONG. applyUrlParams() at
              inventory.astro:478 reads price, body and drive, and it is live. The chips
              worked for users. The honest trade-off of this change is that a shopper now
              lands on a purpose-built page rather than a filtered grid, which is a
              reasonable swap for crawlability, but it was not a broken-for-users fix. */}
          {[
            { label: 'View All', href: `${base}/inventory`, cls: 'sm:hidden bg-orange border-orange text-navy font-bold hover:bg-orange-light', cta: 'browse' },
            { label: 'Under $10K', href: `${base}/used-cars-under-10000-skokie`, cls: 'bg-white/15 border-white/25 text-white font-semibold hover:bg-white/30' },
            { label: 'Under $15K', href: `${base}/used-cars-under-15000-skokie`, cls: 'bg-white/15 border-white/25 text-white font-semibold hover:bg-white/30' },
            { label: 'SUVs', href: `${base}/used-suvs-skokie-il`, cls: 'hidden sm:inline-flex bg-white/15 border-white/25 text-white font-semibold hover:bg-white/30' },
          ].map(chip => (
            <a href={chip.href} data-cta={chip.cta ? 'hero' : undefined} data-cta-name={chip.cta}
               class={`inline-flex items-center min-h-[44px] px-3.5 rounded-full border text-sm backdrop-blur-sm transition-all ${chip.cls}`}>
              {chip.label}
            </a>
          ))}
        </div>
        {/* Whole row hidden below sm on English phones: the orange View All pill above
            and the sticky bar already cover it, and hiding it lifts the first price above
            Safari's toolbar (R2 3C). */}
        <div class="hidden sm:flex sm:flex-row gap-3">
          <a href={`${base}/inventory`} data-cta="hero" data-cta-name="browse"
             class="inline-flex items-center justify-center gap-2 bg-orange text-navy px-6 min-h-[48px] rounded-xl font-bold text-base hover:bg-orange-light transition-colors shadow-lg">
            Browse Inventory <Icon name="arrow_forward" class="text-lg" />
          </a>
          <a href={`${base}/financing#apply`} data-cta="hero" data-cta-name="prequalify"
             class="inline-flex items-center justify-center gap-2 bg-white/15 backdrop-blur-sm border-2 border-white/40 text-white px-6 min-h-[48px] rounded-xl font-bold text-base hover:bg-white/25 transition-all">
            <Icon name="payments" class="text-lg" fill />
            Get Prequalified
          </a>
        </div>

        {/* The mobile rotating review card used to sit here, in the hero flow, and it
            was 216px of the 816px mobile hero on its own. It moved below the featured
            grid (2026-08-15), and in September 2026 it became a static Google review
            after the second car (R2-05). Desktop keeps the rotator over the hero photo
            from lg up. On phones the pinned header chip carries the rating. */}
      </div>
    </div>
  </section>

  <!-- Featured Vehicles -->
  <!-- Header row md and up only: on phones it was 196 px between the CTA and the first car (D1-18). -->
  <section class="pt-4 pb-10 md:py-10 bg-surface">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="hidden md:flex justify-between items-center mb-6">
        <div>
          <span class="text-orange-ink font-bold uppercase tracking-widest text-sm mb-1 block">Current Inventory</span>
          <h2 class="font-headline text-2xl md:text-3xl font-extrabold">Hand Picked. Every One.</h2>
          <p class="text-gray-500 text-sm mt-1">We don't carry 200 cars. We carry the right ones.</p>
        </div>
        <a href={`${base}/inventory`} class="flex items-center gap-1 min-h-[44px] text-orange-ink font-bold hover:text-navy transition-colors text-sm">
          View All <Icon name="arrow_forward" class="text-lg" />
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {/* First card is the phone LCP: eager, high priority (P1-11). The static Google
            review sits after the second car, phones only; static so nothing shifts (R2-05). */}
        {featured.map((v, i) => (<>
          <VehicleCard
            priority={i === 0}
            slug={v.slug}
            stockNumber={v.stockNumber}
            year={v.year}
            make={v.make}
            model={v.model}
            trim={v.trim}
            price={v.price}
            mileage={v.mileage}
            drivetrain={v.drivetrain}
            engine={v.engine}
            bodyStyle={v.bodyStyle}
            photoPath={v.photoPath}
            photoPrefix={v.photoPrefix}
            inspected={v.inspected}
            primaryPhotoUrl={v.primaryPhotoUrl}
            photos={v.photos}
            dealRating={(v as any).dealRating}
            priceSavings={(v as any).priceSavings}
          />{i === 1 && <ReviewRotator reviews={heroReviews} static class="md:hidden w-full" />}</>))}
      </div>
      <p class="text-sm text-gray-600 mt-4">* Est. payment based on 10% down, 9.9% APR, 60-month term. For illustrative purposes only. Actual terms vary by credit.</p>
      <div class="text-center mt-8 md:hidden">
        <a href={`${base}/inventory`} class="inline-flex items-center gap-2 bg-navy text-white px-8 py-4 rounded-xl font-bold hover:bg-navy-light transition-colors">
          View All Inventory <Icon name="arrow_forward" />
        </a>
      </div>
      <!-- Shipping callout -->
      <div class="mt-8 flex items-center justify-center gap-3 bg-navy/5 border border-navy/10 rounded-xl px-6 py-4">
        <Icon name="local_shipping" class="text-2xl text-navy shrink-0" fill />
        <p class="text-sm text-gray-700">
          <span class="font-bold text-navy">Rather buy from home?</span> Complete the entire purchase online, local or nationwide. Pick up or get it delivered.
          <a href={`${base}/ship`} class="text-orange font-bold hover:underline ml-1">How it works →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Three Pillars. The fee promise leads (D1-19); inspection and plates carry the
       section 5 strings word for word, never stronger (P1-20). -->
  <section class="py-10 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="flex items-start gap-4 p-4 md:p-6 rounded-xl border border-gray-100 hover:border-orange/20 hover:shadow-md transition-all">
          <div class="w-12 h-12 bg-navy/5 rounded-xl flex items-center justify-center shrink-0">
            <Icon name="sell" class="text-2xl text-navy" fill />
          </div>
          <div class="min-w-0">
            <h3 class="font-headline text-base font-bold mb-1">No Dealer Fees Ever</h3>
            <p class="text-gray-500 text-sm">No doc fee · The price you see is the price you pay · Financing for all credit levels</p>
          </div>
        </div>
        <div class="flex items-start gap-4 p-4 md:p-6 rounded-xl border border-gray-100 hover:border-orange/20 hover:shadow-md transition-all">
          <div class="w-12 h-12 bg-navy/5 rounded-xl flex items-center justify-center shrink-0">
            <Icon name="gpp_good" class="text-2xl text-navy" fill />
          </div>
          <div class="min-w-0">
            <h3 class="font-headline text-base font-bold mb-1">Inspected & Documented</h3>
            <p class="text-gray-500 text-sm">Every car is inspected before it goes on the lot, and a free CARFAX comes with it. Ask Jerry what was checked on any car before you decide.</p>
          </div>
        </div>
        <div class="flex items-start gap-4 p-4 md:p-6 rounded-xl border border-gray-100 hover:border-orange/20 hover:shadow-md transition-all">
          <div class="w-12 h-12 bg-navy/5 rounded-xl flex items-center justify-center shrink-0">
            <Icon name="directions_car" class="text-2xl text-navy" fill />
          </div>
          <div class="min-w-0">
            <h3 class="font-headline text-base font-bold mb-1">Skip the DMV</h3>
            <p class="text-gray-500 text-sm">Metal plates issued the same visit, so you can drive home that day.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- We Buy Cars -->
  <section class="py-10 bg-white border-t border-gray-100">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="bg-navy rounded-2xl p-8 md:p-10 flex flex-col md:flex-row items-center gap-6 md:gap-10">
        <div class="w-16 h-16 bg-orange/20 rounded-2xl flex items-center justify-center shrink-0">
          <Icon name="monetization_on" class="text-4xl text-orange" fill />
        </div>
        <div class="flex-1 text-center md:text-left">
          <h2 class="font-headline text-2xl md:text-3xl font-extrabold text-white mb-2">Selling Your Car? We Buy Private Party.</h2>
          <p class="text-gray-300 text-base">Get a fast, fair cash offer. No dealer games, no lowball tricks. Text Jerry a photo and your asking price.</p>
        </div>
        <a href="tel:8475108947" aria-label="Call Maxim Autos at (847) 510-8947" class="hidden sm:inline-flex shrink-0 items-center gap-2 bg-white/10 border border-white/20 text-white px-8 py-4 rounded-xl font-bold text-lg whitespace-nowrap hover:opacity-90 transition-opacity">
          <Icon name="phone" fill />
          (847) 510-8947
        </a>
      </div>
    </div>
  </section>

  <!-- Reviews -->
  <section class="py-12 bg-navy text-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-10">
        <div class="flex justify-center items-center gap-1 mb-4">
          {[1,2,3,4,5].map(() => (
            <Icon name="star" class="text-orange text-2xl" fill />
          ))}
        </div>
        <h2 class="font-headline text-3xl md:text-5xl font-extrabold mb-3">{reviewsMeta.rating.toFixed(1)} Stars on Google</h2>
        <p class="text-gray-400 text-lg">{reviewsMeta.count}+ reviews from North Shore neighbors</p>
        {offGoogleSources.length > 0 && (
          <p class="text-gray-400 text-sm mt-4">Recent reviews from {offGoogleSources.join(' and ')}</p>
        )}
      </div>
      {reviews.length > 0 && (
      <!-- Mobile: swipeable snap carousel (12 stacked cards is an unusable scroll).
           Desktop: unchanged 3-up grid. -->
      <div class="flex gap-6 overflow-x-auto snap-x snap-mandatory pb-4 -mx-6 px-6 md:mx-0 md:px-0 md:pb-0 md:grid md:grid-cols-3 md:overflow-x-visible">
        {reviews.map(review => (
          <div class="bg-white/5 p-8 rounded-xl border border-white/10 shrink-0 w-[85vw] snap-center md:w-auto md:shrink">
            <div class="flex items-center gap-1 mb-4" aria-label={review.rating + ' stars'}>
              {Array.from({ length: review.rating }).map(() => (
                <Icon name="star" class="text-orange text-sm" fill />
              ))}
            </div>
            <p class="text-lg italic mb-6 leading-relaxed text-gray-300">"{review.text}"</p>
            <div class="flex items-center justify-between">
              <span class="font-bold text-orange">{review.name}</span>
              <span class="text-xs text-gray-500">{review.source}</span>
            </div>
          </div>
        ))}
      </div>
      <div class="text-center mt-10">
        <a href={`${base}/testimonials`} class="inline-flex items-center gap-2 text-orange font-bold hover:underline">
          Read All Reviews <Icon name="arrow_forward" />
        </a>
      </div>
      )}
    </div>
  </section>

  <!-- Serving North Shore -->
  <section class="py-10 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-center gap-8">
        <div class="flex-1">
          <h2 class="font-headline text-2xl md:text-3xl font-extrabold mb-3">Serving Chicago's North Shore</h2>
          <p class="text-gray-600 mb-4">Located in Skokie. Inspected used cars from {facts.inventory.bandText} with financing for all credit levels.</p>
          <div class="flex flex-wrap gap-2 mb-5">
            {['Skokie', 'Evanston', 'Niles', 'Morton Grove', 'Lincolnwood', 'Des Plaines', 'Wilmette', 'Glenview', 'Chicago'].map(city => (
              <span class="px-3 py-1.5 bg-surface rounded-full text-sm font-medium text-gray-700 border border-gray-200">{city}</span>
            ))}
          </div>
          <a href="https://www.google.com/search?q=Maxim+Autos+9101+Terminal+Ave+Skokie+IL+60077+directions" target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-navy text-white px-6 py-3 rounded-xl font-bold hover:bg-navy-light transition-colors">
            <Icon name="location_on" fill />
            Get Directions
          </a>
        </div>
        <div class="w-full h-44 md:w-72 md:h-48 bg-surface rounded-2xl overflow-hidden border border-gray-200">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2970!2d-87.7546134!3d42.0464352!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x880fcfcb0a430aed%3A0x4d36c77af06ce602!2sMaxim%20Autos!5e0!3m2!1sen!2sus!4v1747612800000!5m2!1sen!2sus"
            width="100%" height="100%" style="border:0;" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
            title="Maxim Autos location map Skokie IL"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- Areas We Serve -->
  <section class="py-12 bg-surface border-t border-gray-100">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-8">
        <span class="text-orange font-bold uppercase tracking-widest text-sm mb-2 block">Service Area</span>
        <h2 class="font-headline text-2xl md:text-3xl font-extrabold text-navy mb-3">We Bring the Dealership to Your Neighborhood</h2>
        <p class="text-gray-600 text-base max-w-2xl mx-auto">Serving Skokie, Evanston, Niles, and all surrounding communities on Chicago's North Shore.</p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-3">
        {suburbs.map(s => (
          <a
            href={`${base}/used-cars-${s.slug}-il`}
            class="group flex flex-col items-center justify-center text-center p-4 rounded-xl bg-white border border-gray-200 hover:border-orange/40 hover:shadow-md transition-all"
          >
            <span class="font-headline font-bold text-navy text-sm group-hover:text-orange transition-colors">{s.city}</span>
            <span class="text-xs text-gray-400 mt-0.5">Used Cars</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="py-12 bg-navy">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
      <h2 class="font-headline text-3xl md:text-4xl font-extrabold text-white mb-4">Ready to Find Your Next Car?</h2>
