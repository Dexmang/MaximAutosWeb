---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import VehicleCard from '../../components/VehicleCard.astro';
import PriceBandNote from '../../components/PriceBandNote.astro';
import ReviewRotator from '../../components/ReviewRotator.astro';
import Icon from '../../components/Icon.astro';
import vehicles from '../../data/vehicles.json';
import reviews from '../../data/reviews.json';
import reviewsMeta from '../../data/reviews_meta.json';
import suburbs from '../../data/suburbs.json';

import facts from '../../data/facts.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Titulo de 58 caracteres; descripcion de 151 hoy (D2-03, D2-04). Todos los numeros
// vienen de facts.json. Tambien corrige el "de de" que la plantilla anterior producia.
const title = 'Autos Usados en Skokie, Sin Cargos de Dealer | Maxim Autos';
const description = `${facts.reviews.ratingTextEs} con ${facts.reviews.count} resenas. Sin cargos de dealer. ${facts.inventory.stockLineTextEs}, en Skokie, IL. Placas el mismo dia.`;
const featured = vehicles.filter(v => (v as any).status !== 'sold').slice(0, 6);
// Ver index.astro: etiqueta de origen solo cuando NO todas las resenas son de Google.
const offGoogleSources = [...new Set(reviews.filter(r => r.source !== 'Google').map(r => r.source))];
const heroReviews = reviews.slice(0, 6);
---

<Layout
  title={title}
  description={description}
  lang="es"
  hreflangEn="https://www.maximautos.com/"
  hreflangEs="https://www.maximautos.com/es"
>
  <Fragment slot="structured-data">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AutoDealer",
      "name": "Maxim Autos",
      "sameAs": [
        "https://www.google.com/maps/place/Maxim+Autos/@42.0464352,-87.7546134,17z/data=!3m1!4b1!4m6!3m5!1s0x880fcfcb0a430aed:0x4d36c77af06ce602!8m2!3d42.0464352!4d-87.7546134!16s%2Fg%2F11wmzx_p4t",
        "https://www.mapquest.com/us/illinois/maxim-autos-814974890"
      ],
      "description": description,
      "url": "https://www.maximautos.com/es",
      "telephone": "+1-847-510-8947",
      "email": "jfranco@maximautos.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "9101 Terminal Ave",
        "addressLocality": "Skokie",
        "addressRegion": "IL",
        "postalCode": "60077",
        "addressCountry": "US"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 42.0464352,
        "longitude": -87.7546134
      },
      "openingHoursSpecification": [
        { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Thursday","Friday"], "opens": "15:00", "closes": "19:00" },
        { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "10:00", "closes": "15:00" }
      ],
      "priceRange": facts.inventory.priceRangeEs,
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": String(reviewsMeta.rating.toFixed(1)),
        "reviewCount": String(reviewsMeta.count),
        "bestRating": "5"
      }
    })} />
  </Fragment>

  <Header slot="header" lang="es" />

  <!-- Hero -->
  <section class="bg-navy overflow-hidden md:relative md:min-h-[224px] lg:min-h-[256px] md:flex md:items-center">
    <!-- Foto del hero solo desde md. Ver index.astro (D1-09, D1-10): en telefonos coincide
         un gif de 1x1 en linea y la foto de 108,944 bytes nunca se descarga. -->
    <div class="hidden md:block relative w-full overflow-hidden md:overflow-visible md:absolute md:inset-0 md:z-0">
      <picture>
        <source media="(max-width: 767px)" srcset="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" width="1" height="1" />
        <source media="(min-width: 768px)" srcset={`${base}/brand/hero-family.webp`} type="image/webp" width="1024" height="572" />
        <img
          src={`${base}/brand/hero-family.jpg`}
          alt="Familia disfrutando su auto comprado en Maxim Autos en Skokie IL"
          width="1024"
          height="572"
          class="w-full h-auto md:h-full md:object-cover md:object-center"
          style="aspect-ratio:1024/572"
          loading="eager"
          fetchpriority="high"
        />
      </picture>
      <div class="hidden md:block absolute inset-0 bg-gradient-to-r from-navy/90 via-navy/70 to-navy/20"></div>

      <!-- Tarjeta de resena rotativa: abajo a la derecha, solo desde lg (R2-07). En telefonos
           va una resena de Google fija despues del segundo auto. -->
      <ReviewRotator reviews={heroReviews} lang="es" class="hidden lg:block absolute bottom-4 right-6 lg:bottom-5 lg:right-8 w-64 lg:w-72" />
    </div>

    <div class="relative z-10 w-full max-w-7xl mx-auto px-6 lg:px-8 pt-4 pb-4 md:py-5">
      <div class="max-w-xl md:max-w-2xl">
        {/* Insignia de calificacion desde md; en telefonos la lleva el chip del encabezado (D1-11). */}
        <a href="https://www.google.com/search?q=Maxim+Autos+Skokie+IL+reviews" target="_blank" rel="noopener"
           data-cta="hero" data-cta-name="google_reviews"
           class="hidden md:inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 text-white rounded-full px-3 py-1 mb-2 hover:bg-white/20 transition-colors">
          <Icon name="star" class="text-orange text-sm" fill />
          <span class="font-bold text-sm">{facts.reviews.ratingValue} Estrellas en Google</span>
          <span class="text-white/60 text-xs">· {facts.reviews.count} Resenas</span>
        </a>
        <h1 class="font-headline text-2xl md:text-3xl lg:text-4xl font-extrabold text-white leading-tight tracking-tight mb-1">
          Autos Usados en Skokie, IL
        </h1>
        <p class="hidden md:block font-headline text-base md:text-lg lg:text-xl font-bold text-white mb-1">Cero Cargos de Dealer.</p>
        {/* Frase del segmento desde md; en telefonos queda la nota del rango real sola (D1-14). */}
        <p class="hidden md:block text-sm md:text-base text-white/80 mb-1 leading-snug text-balance">
          Especializados en el rango de {facts.inventory.segmentTextEs}, solo autos seleccionados a mano. Lleva tu auto el mismo dia.
        </p>
        {/* Paired note, required. See PriceBandNote.astro and the unpaired-segment-band
            rule in scripts/lint-copy.mjs. Guardrail D4: every English disclosure needs its
            Spanish equivalent on the matching /es/ page. */}
        <PriceBandNote lang="es" class="text-white mb-3 max-w-lg md:max-w-2xl" />
        {/* Chips: apuntaban a /es/inventario?price= y ?body=, que robots.txt bloquea con
            `Disallow: /es/inventario?`. Ahora apuntan a /es/inventario sin parametros
            (September P1-21). Como los tres llevan a la misma URL, se ocultan bajo md y en
            telefonos queda visible Ver Inventario (decision 5 del SPEC). */}
        <div class="hidden md:flex flex-wrap gap-2 mb-3">
          {[
            { label: 'Menos de $10K', href: `${base}/es/inventario` },
            { label: 'SUVs', href: `${base}/es/inventario` },
            { label: 'Sedanes', href: `${base}/es/inventario` },
          ].map(chip => (
            <a href={chip.href}
               class="inline-flex items-center min-h-[44px] px-3.5 rounded-full border text-sm backdrop-blur-sm transition-all bg-white/15 border-white/25 text-white font-semibold hover:bg-white/30">
              {chip.label}
            </a>
          ))}
        </div>
        {/* Ver Inventario sigue visible en telefonos porque los chips estan ocultos bajo md.
            Financiamiento desde sm; no existe formulario de precalificacion en espanol (R1-23). */}
        <div class="flex flex-col sm:flex-row gap-3">
          <a href={`${base}/es/inventario`} data-cta="hero" data-cta-name="browse"
             class="inline-flex items-center justify-center gap-2 bg-orange text-navy px-6 min-h-[48px] rounded-xl font-bold text-base hover:bg-orange-light transition-colors shadow-lg">
            Ver Inventario <Icon name="arrow_forward" class="text-lg" />
          </a>
          <a href={`${base}/es/financiamiento`} data-cta="hero" data-cta-name="financing"
             class="hidden sm:inline-flex items-center justify-center gap-2 bg-white/15 backdrop-blur-sm border-2 border-white/40 text-white px-6 min-h-[48px] rounded-xl font-bold text-base hover:bg-white/25 transition-all">
            <Icon name="payments" class="text-lg" fill />
            Financiamiento
          </a>
        </div>

        {/* La tarjeta movil se movio bajo la parrilla de vehiculos (2026-08-15), y en
            septiembre 2026 paso a ser una resena de Google fija despues del segundo auto
            (R2-05). La de escritorio va sobre la foto del hero desde lg. */}
      </div>
    </div>
  </section>

  <!-- Vehiculos Destacados -->
  <!-- Encabezado solo desde md: en telefonos eran 196 px entre el CTA y el primer auto (D1-18). -->
  <section class="pt-4 pb-10 md:py-10 bg-surface">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="hidden md:flex justify-between items-center mb-6">
        <div>
          <span class="text-orange-ink font-bold uppercase tracking-widest text-sm mb-1 block">Inventario Actual</span>
          <h2 class="font-headline text-2xl md:text-3xl font-extrabold">Seleccionados a Mano. Cada Uno.</h2>
          <p class="text-gray-500 text-sm mt-1">No vendemos 200 autos. Vendemos los correctos.</p>
        </div>
        <a href={`${base}/es/inventario`} class="flex items-center gap-1 min-h-[44px] text-orange-ink font-bold hover:text-navy transition-colors text-sm">
          Ver Todo <Icon name="arrow_forward" class="text-lg" />
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {/* Primer auto: carga inmediata y prioridad alta (P1-11). Resena de Google fija
            despues del segundo auto, solo telefonos, sin rotacion (R2-05). */}
        {featured.map((v, i) => (<>
          <VehicleCard
            lang="es"
            priority={i === 0}
            slug={v.slug}
            stockNumber={v.stockNumber}
            year={v.year}
            make={v.make}
            model={v.model}
            trim={v.trim}
            price={v.price}
            mileage={v.mileage}
            drivetrain={v.drivetrain}
            engine={v.engine}
            bodyStyle={v.bodyStyle}
            photoPath={v.photoPath}
            photoPrefix={v.photoPrefix}
            inspected={v.inspected}
            primaryPhotoUrl={v.primaryPhotoUrl}
            photos={v.photos}
            dealRating={(v as any).dealRating}
            priceSavings={(v as any).priceSavings}
          />{i === 1 && <ReviewRotator reviews={heroReviews} lang="es" static class="md:hidden w-full" />}</>))}
      </div>
      <p class="text-sm text-gray-600 mt-4">* Pago estimado con 10% de enganche, 9.9% APR, plazo de 60 meses. Solo para fines ilustrativos. Los términos reales varían según el crédito.</p>
      <div class="text-center mt-8 md:hidden">
        <a href={`${base}/es/inventario`} class="inline-flex items-center gap-2 bg-navy text-white px-8 py-4 rounded-xl font-bold hover:bg-navy-light transition-colors">
          Ver Todo el Inventario <Icon name="arrow_forward" />
        </a>
      </div>
      <!-- Entrega nacional -->
      <div class="mt-8 flex items-center justify-center gap-3 bg-navy/5 border border-navy/10 rounded-xl px-6 py-4">
        <Icon name="local_shipping" class="text-2xl text-navy shrink-0" fill />
        <p class="text-sm text-gray-700">
          <span class="font-bold text-navy">Prefiero comprar desde casa?</span> Completa toda la compra en linea, local o a nivel nacional. Recoge en Skokie o pide entrega a domicilio.
          <a href={`${base}/es/compra-en-linea`} class="text-orange font-bold hover:underline ml-1">Como funciona →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Tres Pilares. La promesa de cero cargos va primero (D1-19); inspeccion y placas
       con la misma fuerza que las frases de la seccion 5, nunca mas (P1-20, S30). -->
  <section class="py-10 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="flex items-start gap-4 p-4 md:p-6 rounded-xl border border-gray-100 hover:border-orange/20 hover:shadow-md transition-all">
          <div class="w-12 h-12 bg-navy/5 rounded-xl flex items-center justify-center shrink-0">
            <Icon name="sell" class="text-2xl text-navy" fill />
          </div>
          <div class="min-w-0">
            <h3 class="font-headline text-base font-bold mb-1">Nunca Cobramos Cargos de Dealer</h3>
            <p class="text-gray-500 text-sm">Sin cargos ocultos · Precios claros · Financiamiento para todos los niveles de credito</p>
          </div>
        </div>
        <div class="flex items-start gap-4 p-4 md:p-6 rounded-xl border border-gray-100 hover:border-orange/20 hover:shadow-md transition-all">
          <div class="w-12 h-12 bg-navy/5 rounded-xl flex items-center justify-center shrink-0">
            <Icon name="gpp_good" class="text-2xl text-navy" fill />
          </div>
          <div class="min-w-0">
            <h3 class="font-headline text-base font-bold mb-1">Inspeccionado y Documentado</h3>
            <p class="text-gray-500 text-sm">Cada auto se inspecciona antes de llegar al lote, y trae un CARFAX gratis. Preguntale a Jerry que se reviso en cualquier auto antes de decidir.</p>
          </div>
        </div>
        <div class="flex items-start gap-4 p-4 md:p-6 rounded-xl border border-gray-100 hover:border-orange/20 hover:shadow-md transition-all">
          <div class="w-12 h-12 bg-navy/5 rounded-xl flex items-center justify-center shrink-0">
            <Icon name="directions_car" class="text-2xl text-navy" fill />
          </div>
          <div class="min-w-0">
            <h3 class="font-headline text-base font-bold mb-1">Placas el Mismo Dia</h3>
            <p class="text-gray-500 text-sm">Placas de metal entregadas en la misma visita, para que manejes a casa ese dia.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Compramos Tu Auto -->
  <section class="py-10 bg-white border-t border-gray-100">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="bg-navy rounded-2xl p-8 md:p-10 flex flex-col md:flex-row items-center gap-6 md:gap-10">
        <div class="w-16 h-16 bg-orange/20 rounded-2xl flex items-center justify-center shrink-0">
          <Icon name="monetization_on" class="text-4xl text-orange" fill />
        </div>
        <div class="flex-1 text-center md:text-left">
          <h2 class="font-headline text-2xl md:text-3xl font-extrabold text-white mb-2">Vendes Tu Auto? Te Compramos Directamente.</h2>
          <p class="text-gray-300 text-base">Recibe una oferta rapida y justa. Sin juegos de concesionario, sin ofertas bajas. Manda una foto a Jerry con tu precio.</p>
        </div>
        <div class="hidden sm:inline-flex shrink-0 items-center gap-2 bg-white/10 border border-white/20 text-white px-8 py-4 rounded-xl font-bold text-lg whitespace-nowrap">
          <Icon name="phone" fill />
          (847) 510-8947
        </div>
      </div>
    </div>
  </section>

  <!-- Resenas -->
  <section class="py-12 bg-navy text-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-10">
        <div class="flex justify-center items-center gap-1 mb-4">
          {[1,2,3,4,5].map(() => (
            <Icon name="star" class="text-orange text-2xl" fill />
          ))}
        </div>
        <h2 class="font-headline text-3xl md:text-5xl font-extrabold mb-3">{reviewsMeta.rating.toFixed(1)} Estrellas en Google</h2>
        <p class="text-gray-400 text-lg">{reviewsMeta.count}+ resenas de vecinos del North Shore</p>
        {offGoogleSources.length > 0 && (
          <p class="text-gray-400 text-sm mt-4">Resenas recientes de {offGoogleSources.join(' y ')}</p>
        )}
      </div>
      {reviews.length > 0 && (
      <div class="flex gap-6 overflow-x-auto snap-x snap-mandatory pb-4 -mx-6 px-6 md:mx-0 md:px-0 md:pb-0 md:grid md:grid-cols-3 md:overflow-x-visible">
        {reviews.map(review => (
          <div class="bg-white/5 p-8 rounded-xl border border-white/10 shrink-0 w-[85vw] snap-center md:w-auto md:shrink">
            <div class="flex items-center gap-1 mb-4" aria-label={review.rating + ' estrellas'}>
              {Array.from({ length: review.rating }).map(() => (
                <Icon name="star" class="text-orange text-sm" fill />
              ))}
            </div>
            <p class="text-lg italic mb-6 leading-relaxed text-gray-300">"{review.text}"</p>
            <div class="flex items-center justify-between">
              <span class="font-bold text-orange">{review.name}</span>
              <span class="text-xs text-gray-500">{review.source}</span>
            </div>
          </div>
        ))}
      </div>
      <div class="text-center mt-10">
        <a href={`${base}/testimonials`} class="inline-flex items-center gap-2 text-orange font-bold hover:underline">
          Leer Todas las Resenas <Icon name="arrow_forward" />
        </a>
      </div>
      )}
    </div>
  </section>

  <!-- Servicio en el North Shore -->
  <section class="py-10 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-center gap-8">
        <div class="flex-1">
          <h2 class="font-headline text-2xl md:text-3xl font-extrabold mb-3">Servicio en el North Shore de Chicago</h2>
          <p class="text-gray-600 mb-4">Ubicados en Skokie. Autos usados inspeccionados {facts.inventory.bandTextEs} con financiamiento para todos los niveles de credito.</p>
          <div class="flex flex-wrap gap-2 mb-5">
            {['Skokie', 'Evanston', 'Niles', 'Morton Grove', 'Lincolnwood', 'Des Plaines', 'Wilmette', 'Glenview', 'Chicago'].map(city => (
              <span class="px-3 py-1.5 bg-surface rounded-full text-sm font-medium text-gray-700 border border-gray-200">{city}</span>
            ))}
          </div>
          <a href="https://www.google.com/search?q=Maxim+Autos+9101+Terminal+Ave+Skokie+IL+60077+directions" target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-navy text-white px-6 py-3 rounded-xl font-bold hover:bg-navy-light transition-colors">
            <Icon name="location_on" fill />
            Como Llegar
          </a>
        </div>
        <div class="hidden md:block w-72 h-48 bg-surface rounded-2xl overflow-hidden border border-gray-200">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2970!2d-87.7546134!3d42.0464352!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x880fcfcb0a430aed%3A0x4d36c77af06ce602!2sMaxim%20Autos!5e0!3m2!1sen!2sus!4v1747612800000!5m2!1sen!2sus"
            width="100%" height="100%" style="border:0;" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
            title="Ubicacion de Maxim Autos en Skokie IL"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="py-12 bg-navy">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
      <h2 class="font-headline text-3xl md:text-4xl font-extrabold text-white mb-4">Listo para Encontrar Tu Proximo Auto?</h2>
      <p class="text-white/70 text-lg mb-8">Cada auto seleccionado e inspeccionado personalmente. Llama o manda un mensaje de texto a Jerry para una respuesta rapida.</p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <div class="hidden sm:inline-flex items-center justify-center gap-2 bg-orange text-white px-8 py-4 rounded-xl font-bold text-lg">
          <Icon name="phone" fill />
          (847) 510-8947
        </div>
        <a href={`${base}/es/aplicacion-de-credito`} class="inline-flex items-center justify-center gap-2 bg-white/10 text-white px-8 py-4 rounded-xl font-bold text-lg hover:bg-white/20 transition-colors border border-white/20">
          <Icon name="payments" fill />
          Aplicar Ahora
        </a>
        <a href={`${base}/es/inventario`} class="inline-flex items-center justify-center gap-2 bg-white/10 text-white px-8 py-4 rounded-xl font-bold text-lg hover:bg-white/20 transition-colors border border-white/20">
          Ver Inventario
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" lang="es" />
</Layout>
