---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import VehicleCard from '../components/VehicleCard.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import vehicles from '../data/vehicles.json';
import reviewsMeta from '../data/reviews_meta.json';

import facts from '../data/facts.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// bodyStyle values seen live in vehicles.json on 2026-09-24: Sedan, SUV, Van, Wagon.
// DealerCenter files the Pacifica as "Van" and the Mazda5 as "Wagon", so both body styles
// count. A three row SUV is a family car too, and DealerCenter has no field for it, so the
// listing copy is read for a third row mention (Journey and Sorento match this way today).
const FAMILY_BODY_RE = /\b(?:mini\s?van|van|wagon)\b/i;
const THIRD_ROW_RE = /\b(?:third|3rd|three)[\s-]?rows?\b|\b(?:seven|7|eight|8)[\s-]?passenger\b|\bseating for (?:seven|eight)\b/i;
const live = vehicles.filter(v => (v as any).status !== 'sold');
const matches = live.filter(v => {
  const blob = [(v as any).description ?? '', ...(((v as any).highlights ?? []) as string[])].join(' ');
  return FAMILY_BODY_RE.test(v.bodyStyle || '') || THIRD_ROW_RE.test(blob);
});

// Every number on this page is computed from the matches or read from facts.json.
const fmt = (n: number) => `$${n.toLocaleString('en-US')}`;
const n = matches.length;
const priced = matches.map(v => v.price).filter(p => typeof p === 'number' && p > 0);
const minPrice = priced.length ? Math.min(...priced) : 0;
const maxPrice = priced.length ? Math.max(...priced) : 0;
const priceText = priced.length
  ? (minPrice === maxPrice ? `priced at ${fmt(minPrice)}` : `priced ${fmt(minPrice)} to ${fmt(maxPrice)}`)
  : '';
const lineup = matches.map(v => [v.year, v.make, v.model, v.trim].filter(Boolean).join(' ')).join(', ');

const canonicalUrl = 'https://www.maximautos.com/used-minivans-family-cars-skokie-il';
const title = 'Used Minivans and Family Cars in Skokie IL · Maxim Autos';
const description = n > 0
  ? `Used minivans and three row family cars in Skokie, IL, ${fmt(minPrice)} to ${fmt(maxPrice)}. Every car inspected, free CARFAX. Financing for all credit levels.`
  : 'Used minivans and three row family cars in Skokie, IL. Inventory rotates weekly. Every car inspected, free CARFAX. Financing for all credit levels.';

const quickAnswer = n > 0
  ? `Maxim Autos has ${n} used ${n === 1 ? 'minivan or three row family vehicle' : 'minivans and three row family vehicles'} in stock today at 9101 Terminal Ave in Skokie, IL, ${priceText}. Every car is inspected before it goes on the lot, and a free CARFAX comes with it. Metal plates issued the same visit, for cars registered in Illinois.`
  : 'Maxim Autos in Skokie, IL has no minivans or three row family vehicles on the lot today. Inventory rotates weekly and the owner buys at auction every week, so text (847) 510-8947 with what you need. Every car is inspected before it goes on the lot, and a free CARFAX comes with it.';

const faqs = [
  {
    q: 'Does Maxim Autos have used minivans in stock near Skokie?',
    a: n > 0
      ? `Yes. ${n} ${n === 1 ? 'minivan or three row family vehicle is' : 'minivans and three row family vehicles are'} on the lot today at 9101 Terminal Ave in Skokie, ${priceText}. Inventory rotates weekly, so text (847) 510-8947 if you want to hear about the next one before it lists.`
      : 'Not today. Inventory rotates weekly. Text (847) 510-8947 with the seating you need and your budget and Jerry will reach out when one lands.'
  },
  {
    q: 'Do the family cars on this page have a third row?',
    a: 'The vehicles on this page are minivans, wagons, or SUVs whose listing describes a third row. Seating counts differ by model, so check the vehicle page for the exact number, and text (847) 510-8947 if you want it confirmed before you drive over.'
  },
  {
    q: 'Can I finance a family car if my credit is not perfect?',
    a: 'Financing for all credit levels, including first time buyers and those rebuilding credit. Approval is never guaranteed. No dealer fees. The price you see is the price you pay, plus tax, title, and license.'
  }
];

const browseLinks = [
  { href: `${base}/used-cars-under-10000-skokie`, label: 'Under $10,000' },
  { href: `${base}/used-cars-under-15000-skokie`, label: 'Under $15,000' },
  { href: `${base}/used-suvs-skokie-il`, label: 'Used SUVs' },
  { href: `${base}/used-awd-cars-skokie-il`, label: 'AWD and 4WD' },
  { href: `${base}/used-sedans-skokie-il`, label: 'Sedans' },
  { href: `${base}/used-cars-under-100k-miles-skokie`, label: 'Under 100k Miles' },
];

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Used Minivans and Family Cars for Sale in Skokie, IL",
  "itemListElement": matches.map((v, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@type": "Car",
      "name": `${v.year} ${v.make} ${v.model} ${v.trim}`,
      "brand": { "@type": "Brand", "name": v.make },
      "url": `https://www.maximautos.com/vehicle/${v.slug}`,
      "offers": {
        "@type": "Offer",
        "price": v.price,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock"
      }
    }
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.maximautos.com" },
    { "@type": "ListItem", "position": 2, "name": "Inventory", "item": "https://www.maximautos.com/inventory" },
    { "@type": "ListItem", "position": 3, "name": "Used Minivans and Family Cars", "item": canonicalUrl }
  ]
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "AutoDealer",
  "name": "Maxim Autos",
  "url": "https://www.maximautos.com",
  "telephone": "+1-847-510-8947",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "9101 Terminal Ave",
    "addressLocality": "Skokie",
    "addressRegion": "IL",
    "postalCode": "60077",
    "addressCountry": "US"
  },
  "geo": { "@type": "GeoCoordinates", "latitude": 42.0464352, "longitude": -87.7546134 },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": String(reviewsMeta.rating.toFixed(1)),
    "reviewCount": String(reviewsMeta.count),
    "bestRating": "5"
  }
};
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl}>
  <Fragment slot="structured-data">
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  </Fragment>
  <Header slot="header" />

  <!-- Hero -->
  <section class="bg-navy py-14 lg:py-20">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <nav class="text-sm text-gray-400 mb-8" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 flex-wrap">
          <li><a href={`${base}/`} class="hover:text-white transition-colors">Home</a></li>
          <li class="text-gray-600">/</li>
          <li><a href={`${base}/inventory`} class="hover:text-white transition-colors">Inventory</a></li>
          <li class="text-gray-600">/</li>
          <li class="text-gray-300">Minivans and Family Cars</li>
        </ol>
      </nav>
      <div class="text-center">
        <span class="text-orange font-bold uppercase tracking-widest text-sm mb-3 block">Family Cars</span>
        <h1 class="font-headline text-4xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight tracking-tight mb-5">
          Used Minivans and Family Cars Near Skokie, IL
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          Minivans, wagons and three row SUVs with room for the whole household, picked at auction by the owner. Every car is inspected before it goes on the lot, and a free CARFAX comes with it.
        </p>
      </div>
    </div>
  </section>

  <!-- Inventory -->
  <section class="py-14 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex items-center justify-between mb-8 flex-wrap gap-4">
        <div>
          <h2 class="font-headline text-2xl md:text-3xl font-extrabold text-navy">
            {n === 0 ? 'Inventory Refreshes Weekly' : `${n} Family ${n === 1 ? 'Vehicle' : 'Vehicles'} in Stock`}
          </h2>
          <p class="text-gray-600 mt-1 text-sm">All inspected. No dealer fees. Free CARFAX on every car.</p>
        </div>
        <a href={`${base}/inventory`} class="inline-flex items-center gap-2 text-orange font-semibold hover:underline text-sm">
          Full inventory <span class="material-symbols-outlined text-base">arrow_forward</span>
        </a>
      </div>

      {n === 0 ? (
        <div class="bg-surface border border-gray-200 rounded-xl p-8 text-center">
          <p class="text-gray-700 mb-3">No vehicles available right now. Inventory rotates every week.</p>
          <p class="text-gray-700">Text Jerry at <a href="sms:8475108947" class="text-orange font-bold">(847) 510-8947</a> with what you are looking for. He sources cars at auction every week.</p>
        </div>
      ) : (
        <Fragment>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {matches.map((v, i) => (
            <VehicleCard
              slug={v.slug}
              stockNumber={v.stockNumber}
              year={v.year}
              make={v.make}
              model={v.model}
              trim={v.trim}
              price={v.price}
              mileage={v.mileage}
              drivetrain={v.drivetrain}
              engine={v.engine}
              bodyStyle={v.bodyStyle}
              photoPath={v.photoPath}
              photoPrefix={v.photoPrefix}
              inspected={v.inspected}
              primaryPhotoUrl={v.primaryPhotoUrl}
              photos={v.photos}
              priority={i === 0}
            />
          ))}
        </div>
        <p class="text-sm text-gray-600 mt-4">* Est. payment based on 10% down, 9.9% APR, 60-month term. For illustrative purposes only. Actual terms vary by credit.</p>
        </Fragment>
      )}
    </div>
  </section>

  <!-- Copy -->
  <section class="py-14 bg-surface">
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      <div class="mb-10">
        <QuickAnswer answer={quickAnswer} />
      </div>
      <h2 class="font-headline text-2xl md:text-3xl font-extrabold text-navy mb-6">Seats, Doors and Cargo Come Before the Badge</h2>
      <p class="text-gray-700 leading-relaxed mb-5">
        Family buyers on the North Shore shop by the third row and the trunk before they shop by the make. Two car seats and a grandparent, a travel hockey bag, a warehouse store run, a double stroller: the real question is whether it all goes in with the doors closed. A minivan answers that with sliding doors that open in a tight Skokie garage or a busy grocery lot without touching the car next to you, seats that fold into the floor, and a load floor low enough that a kid can climb in alone. A three row SUV gives up some of that space for a higher seat and, on some units, all wheel drive.
      </p>
      <p class="text-gray-700 leading-relaxed mb-5">
        These are bigger vehicles, so be honest with yourself about fuel. A minivan or three row SUV will use more gas than a compact sedan, but it also turns two trips into one and carries the whole household on fuel a second car would otherwise burn. Look at the EPA fuel economy figure on each listing and think about how many of your miles are the school run in {facts.cities.slice(0, 3).join(', ')} and how many are the Edens at highway speed. Jerry Franco, the owner, picks every car at auction himself, and a family hauler has to show him a clean history and an interior that was looked after before it gets a spot on the lot.
      </p>
      <p class="text-gray-700 leading-relaxed mb-5">
        {n > 0 ? `On the lot today: ${lineup}.` : 'Family vehicles in this price range do not sit long, so the list on this page changes often.'} Every car is inspected before it goes on the lot, and a free CARFAX comes with it. Illinois 15 day / 500 mile statutory powertrain protection on qualifying cars. On a family car the CARFAX matters twice: once for accident history, and once for the service records that tell you whether the previous owner kept up with maintenance on a vehicle that worked hard every day.
      </p>
      <p class="text-gray-700 leading-relaxed">
        No dealer fees. The price you see is the price you pay, plus tax, title, and license. Financing for all credit levels, including first time buyers and those rebuilding credit. Approval is never guaranteed. Metal plates issued the same visit, for cars registered in Illinois. {facts.reviews.ratingText} across {facts.reviews.count} reviews. Maxim Autos is at 9101 Terminal Ave in Skokie, IL 60077.
      </p>
    </div>
  </section>

  <!-- FAQ (visible only, no FAQPage JSON-LD by site policy since 2026-05-07) -->
  <section class="py-14 bg-white">
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-10">
        <span class="text-orange font-bold uppercase tracking-widest text-sm mb-2 block">FAQ</span>
        <h2 class="font-headline text-2xl md:text-3xl font-extrabold text-navy">Common Questions About Family Cars Near Skokie</h2>
      </div>
      <div class="space-y-4">
        {faqs.map(item => (
          <div class="bg-surface rounded-xl border border-gray-100 p-6">
            <h3 class="font-headline font-bold text-navy mb-2">{item.q}</h3>
            <p class="text-gray-600 leading-relaxed text-sm">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- More ways to browse -->
  <section class="py-10 bg-surface border-t border-gray-100">
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      <p class="text-xs font-bold text-orange uppercase tracking-widest mb-3">More ways to browse</p>
      <nav aria-label="More ways to browse" class="flex flex-wrap gap-2">
        {browseLinks.map(l => (
          <a href={l.href} class="inline-flex items-center px-4 py-2 rounded-full border border-gray-200 bg-white text-sm font-semibold text-navy hover:border-orange hover:text-orange transition-colors">{l.label}</a>
        ))}
      </nav>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-navy">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
      <h2 class="font-headline text-3xl md:text-4xl font-extrabold text-white mb-4">Room for Everyone, Priced for the Family Budget</h2>
      <p class="text-white/70 text-lg mb-8">Browse the family vehicles, text Jerry, or stop in. Metal plates issued the same visit, for cars registered in Illinois.</p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <div class="hidden sm:inline-flex items-center justify-center gap-2 bg-orange text-white px-8 py-4 rounded-xl font-bold text-lg">
          <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1;">phone</span>
          (847) 510-8947
        </div>
        <a href={`${base}/apply`} class="inline-flex items-center justify-center gap-2 bg-white/10 text-white px-8 py-4 rounded-xl font-bold text-lg hover:bg-white/20 transition-colors border border-white/20">
          <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1;">payments</span>
          Apply for Financing
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
