---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import VehicleCard from '../components/VehicleCard.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import vehicles from '../data/vehicles.json';
import reviewsMeta from '../data/reviews_meta.json';

import facts from '../data/facts.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// mileage is a number on every live record in vehicles.json (checked 2026-09-24). A zero or
// missing mileage renders as "Mileage TBD" on the card, so it is excluded here rather than
// counted as under the cap.
const MILEAGE_CAP = 100000;
const live = vehicles.filter(v => (v as any).status !== 'sold');
const matches = live.filter(v => typeof v.mileage === 'number' && v.mileage > 0 && v.mileage < MILEAGE_CAP);

// Every number on this page is computed from the matches or read from facts.json.
const fmt = (n: number) => `$${n.toLocaleString('en-US')}`;
const fmtMiles = (n: number) => n.toLocaleString('en-US');
const capText = fmtMiles(MILEAGE_CAP);
const n = matches.length;
const priced = matches.map(v => v.price).filter(p => typeof p === 'number' && p > 0);
const minPrice = priced.length ? Math.min(...priced) : 0;
const maxPrice = priced.length ? Math.max(...priced) : 0;
const priceText = priced.length
  ? (minPrice === maxPrice ? `priced at ${fmt(minPrice)}` : `priced ${fmt(minPrice)} to ${fmt(maxPrice)}`)
  : '';
const miles = matches.map(v => v.mileage);
const minMiles = miles.length ? Math.min(...miles) : 0;
const maxMiles = miles.length ? Math.max(...miles) : 0;
const milesText = miles.length
  ? (minMiles === maxMiles ? `${fmtMiles(minMiles)} miles` : `${fmtMiles(minMiles)} to ${fmtMiles(maxMiles)} miles`)
  : '';
const lineup = matches.map(v => [v.year, v.make, v.model, v.trim].filter(Boolean).join(' ')).join(', ');

const canonicalUrl = 'https://www.maximautos.com/used-cars-under-100k-miles-skokie';
const title = 'Used Cars Under 100k Miles in Skokie IL · Maxim Autos';
const description = n > 0
  ? `Used cars under ${capText} miles in Skokie, IL, ${fmt(minPrice)} to ${fmt(maxPrice)}. Every car inspected, free CARFAX. Financing for all credit levels.`
  : `Used cars under ${capText} miles in Skokie, IL. Inventory rotates weekly. Every car inspected, free CARFAX. Financing for all credit levels.`;

const quickAnswer = n > 0
  ? `Maxim Autos has ${n} used ${n === 1 ? 'car' : 'cars'} under ${capText} miles in stock today at 9101 Terminal Ave in Skokie, IL, ${priceText}, showing ${milesText}. Every car is inspected before it goes on the lot, and a free CARFAX comes with it. Metal plates issued the same visit, for cars registered in Illinois.`
  : `Maxim Autos in Skokie, IL has no cars under ${capText} miles on the lot today. Inventory rotates weekly and the owner buys at auction every week, so text (847) 510-8947 with what you need. Every car is inspected before it goes on the lot, and a free CARFAX comes with it.`;

const faqs = [
  {
    q: `Does Maxim Autos have used cars under ${capText} miles in stock near Skokie?`,
    a: n > 0
      ? `Yes. ${n} ${n === 1 ? 'car' : 'cars'} under ${capText} miles ${n === 1 ? 'is' : 'are'} on the lot today at 9101 Terminal Ave in Skokie, ${priceText}, showing ${milesText}. Inventory rotates weekly, so text (847) 510-8947 if you want to hear about the next one before it lists.`
      : 'Not today. Inventory rotates weekly. Text (847) 510-8947 with the mileage ceiling and budget you have in mind and Jerry will reach out when one lands.'
  },
  {
    q: 'Are the cars inspected before they go on the lot?',
    a: 'Every car is inspected before it goes on the lot, and a free CARFAX comes with it. Illinois 15 day / 500 mile statutory powertrain protection on qualifying cars.'
  },
  {
    q: 'Can I finance a lower mileage car if my credit is not perfect?',
    a: 'Financing for all credit levels, including first time buyers and those rebuilding credit. Approval is never guaranteed. No dealer fees. The price you see is the price you pay, plus tax, title, and license.'
  }
];

const browseLinks = [
  { href: `${base}/used-cars-under-10000-skokie`, label: 'Under $10,000' },
  { href: `${base}/used-cars-under-15000-skokie`, label: 'Under $15,000' },
  { href: `${base}/used-suvs-skokie-il`, label: 'Used SUVs' },
  { href: `${base}/used-awd-cars-skokie-il`, label: 'AWD and 4WD' },
  { href: `${base}/used-sedans-skokie-il`, label: 'Sedans' },
  { href: `${base}/used-minivans-family-cars-skokie-il`, label: 'Minivans and Family Cars' },
];

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `Used Cars Under ${capText} Miles for Sale in Skokie, IL`,
  "itemListElement": matches.map((v, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@type": "Car",
      "name": `${v.year} ${v.make} ${v.model} ${v.trim}`,
      "brand": { "@type": "Brand", "name": v.make },
      "url": `https://www.maximautos.com/vehicle/${v.slug}`,
      "mileageFromOdometer": { "@type": "QuantitativeValue", "value": v.mileage, "unitCode": "SMI" },
      "offers": {
        "@type": "Offer",
        "price": v.price,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock"
      }
    }
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.maximautos.com" },
    { "@type": "ListItem", "position": 2, "name": "Inventory", "item": "https://www.maximautos.com/inventory" },
    { "@type": "ListItem", "position": 3, "name": `Used Cars Under ${capText} Miles`, "item": canonicalUrl }
  ]
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "AutoDealer",
  "name": "Maxim Autos",
  "url": "https://www.maximautos.com",
  "telephone": "+1-847-510-8947",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "9101 Terminal Ave",
    "addressLocality": "Skokie",
    "addressRegion": "IL",
    "postalCode": "60077",
    "addressCountry": "US"
  },
  "geo": { "@type": "GeoCoordinates", "latitude": 42.0464352, "longitude": -87.7546134 },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": String(reviewsMeta.rating.toFixed(1)),
    "reviewCount": String(reviewsMeta.count),
    "bestRating": "5"
  }
};
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl}>
  <Fragment slot="structured-data">
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  </Fragment>
  <Header slot="header" />

  <!-- Hero -->
  <section class="bg-navy py-14 lg:py-20">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <nav class="text-sm text-gray-400 mb-8" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 flex-wrap">
          <li><a href={`${base}/`} class="hover:text-white transition-colors">Home</a></li>
          <li class="text-gray-600">/</li>
          <li><a href={`${base}/inventory`} class="hover:text-white transition-colors">Inventory</a></li>
          <li class="text-gray-600">/</li>
          <li class="text-gray-300">Under 100k Miles</li>
        </ol>
      </nav>
      <div class="text-center">
        <span class="text-orange font-bold uppercase tracking-widest text-sm mb-3 block">Lower Mileage</span>
        <h1 class="font-headline text-4xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight tracking-tight mb-5">
          Used Cars Under {capText} Miles Near Skokie, IL
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
          More of the car's life still ahead of it, picked at auction by the owner. Every car is inspected before it goes on the lot, and a free CARFAX comes with it.
        </p>
      </div>
    </div>
  </section>

  <!-- Inventory -->
  <section class="py-14 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex items-center justify-between mb-8 flex-wrap gap-4">
        <div>
          <h2 class="font-headline text-2xl md:text-3xl font-extrabold text-navy">
            {n === 0 ? 'Inventory Refreshes Weekly' : `${n} ${n === 1 ? 'Vehicle' : 'Vehicles'} Under ${capText} Miles`}
          </h2>
          <p class="text-gray-600 mt-1 text-sm">All inspected. No dealer fees. Free CARFAX on every car.</p>
        </div>
        <a href={`${base}/inventory`} class="inline-flex items-center gap-2 text-orange font-semibold hover:underline text-sm">
          Full inventory <span class="material-symbols-outlined text-base">arrow_forward</span>
        </a>
      </div>

      {n === 0 ? (
        <div class="bg-surface border border-gray-200 rounded-xl p-8 text-center">
          <p class="text-gray-700 mb-3">No vehicles available right now. Inventory rotates every week.</p>
          <p class="text-gray-700">Text Jerry at <a href="sms:8475108947" class="text-orange font-bold">(847) 510-8947</a> with what you are looking for. He sources cars at auction every week.</p>
        </div>
      ) : (
        <Fragment>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {matches.map((v, i) => (
            <VehicleCard
              slug={v.slug}
              stockNumber={v.stockNumber}
              year={v.year}
              make={v.make}
              model={v.model}
              trim={v.trim}
              price={v.price}
              mileage={v.mileage}
              drivetrain={v.drivetrain}
              engine={v.engine}
              bodyStyle={v.bodyStyle}
              photoPath={v.photoPath}
              photoPrefix={v.photoPrefix}
              inspected={v.inspected}
              primaryPhotoUrl={v.primaryPhotoUrl}
              photos={v.photos}
              priority={i === 0}
            />
          ))}
        </div>
        <p class="text-sm text-gray-600 mt-4">* Est. payment based on 10% down, 9.9% APR, 60-month term. For illustrative purposes only. Actual terms vary by credit.</p>
        </Fragment>
      )}
    </div>
  </section>

  <!-- Copy -->
  <section class="py-14 bg-surface">
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      <div class="mb-10">
        <QuickAnswer answer={quickAnswer} />
      </div>
      <h2 class="font-headline text-2xl md:text-3xl font-extrabold text-navy mb-6">What {capText} Miles Actually Buys You</h2>
      <p class="text-gray-700 leading-relaxed mb-5">
        Under {capText} miles is the line most buyers draw, and there is a practical reason for it. On many cars the bigger scheduled jobs, the first set of struts, a transmission service, the timing belt on engines that have one, tend to fall due somewhere past that mark. A car that has not reached it yet still has that spending ahead, but it also has the years of ordinary driving before it, and it usually has more of its original parts. In the price range Maxim Autos works in, that is what you are paying for when you choose lower mileage over a newer badge.
      </p>
      <p class="text-gray-700 leading-relaxed mb-5">
        Miles are only half the story, and Jerry Franco, the owner, picks every car at auction himself with the other half in mind. A ten year old car with 70,000 miles sat a lot, and rubber, seals and batteries age on the calendar, not the odometer. A four year old car with 95,000 miles was driven hard but probably on the highway, which is the easiest kind of mile. Look at the year next to the mileage on each card above and do the division. Roughly 12,000 to 15,000 miles a year is the ordinary pattern for a car in {facts.cities.slice(0, 3).join(', ')} or anywhere else on the North Shore. Well under that usually means a second car that sat; well over usually means a highway commute.
      </p>
      <p class="text-gray-700 leading-relaxed mb-5">
        {n > 0 ? `On the lot today under ${capText} miles: ${lineup}.` : `Cars under ${capText} miles in this price range sell quickly, so the list on this page changes often.`} Every car is inspected before it goes on the lot, and a free CARFAX comes with it. Illinois 15 day / 500 mile statutory powertrain protection on qualifying cars. Each listing carries the EPA fuel economy figure; read it alongside the mileage when you compare two cars at a similar price, because the cheaper car to buy is not always the cheaper car to drive for the next five years.
      </p>
      <p class="text-gray-700 leading-relaxed">
        No dealer fees. The price you see is the price you pay, plus tax, title, and license. Financing for all credit levels, including first time buyers and those rebuilding credit. Approval is never guaranteed. Metal plates issued the same visit, for cars registered in Illinois. {facts.reviews.ratingText} across {facts.reviews.count} reviews. Maxim Autos is at 9101 Terminal Ave in Skokie, IL 60077.
      </p>
    </div>
  </section>

  <!-- FAQ (visible only, no FAQPage JSON-LD by site policy since 2026-05-07) -->
  <section class="py-14 bg-white">
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-10">
        <span class="text-orange font-bold uppercase tracking-widest text-sm mb-2 block">FAQ</span>
        <h2 class="font-headline text-2xl md:text-3xl font-extrabold text-navy">Common Questions About Lower Mileage Used Cars Near Skokie</h2>
      </div>
      <div class="space-y-4">
        {faqs.map(item => (
          <div class="bg-surface rounded-xl border border-gray-100 p-6">
            <h3 class="font-headline font-bold text-navy mb-2">{item.q}</h3>
            <p class="text-gray-600 leading-relaxed text-sm">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- More ways to browse -->
  <section class="py-10 bg-surface border-t border-gray-100">
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      <p class="text-xs font-bold text-orange uppercase tracking-widest mb-3">More ways to browse</p>
      <nav aria-label="More ways to browse" class="flex flex-wrap gap-2">
        {browseLinks.map(l => (
          <a href={l.href} class="inline-flex items-center px-4 py-2 rounded-full border border-gray-200 bg-white text-sm font-semibold text-navy hover:border-orange hover:text-orange transition-colors">{l.label}</a>
        ))}
      </nav>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-navy">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
      <h2 class="font-headline text-3xl md:text-4xl font-extrabold text-white mb-4">Find a Car With Miles Left in It</h2>
      <p class="text-white/70 text-lg mb-8">Browse the lower mileage lot, text Jerry, or stop in. Metal plates issued the same visit, for cars registered in Illinois.</p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <div class="hidden sm:inline-flex items-center justify-center gap-2 bg-orange text-white px-8 py-4 rounded-xl font-bold text-lg">
          <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1;">phone</span>
          (847) 510-8947
        </div>
        <a href={`${base}/apply`} class="inline-flex items-center justify-center gap-2 bg-white/10 text-white px-8 py-4 rounded-xl font-bold text-lg hover:bg-white/20 transition-colors border border-white/20">
          <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1;">payments</span>
          Apply for Financing
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
