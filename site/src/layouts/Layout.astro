---
// facts.json is the generated live number ledger (price band, unit count, review count,
// rating, service cities). Never hardcode any of those in a page: a stated band no live
// car falls inside violates 14 Ill. Adm. Code 475.390, which is what was found live on
// 2026-07-25. See scripts/facts-core.mjs.
import facts from '../data/facts.json';
import TrustPair from '../components/TrustPair.astro';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  noIndex?: boolean;
  lang?: string;
  hreflangEn?: string;
  hreflangEs?: string;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const {
  title,
  description,
  ogImage,
  canonicalUrl,
  noIndex = false,
  lang = 'en',
  hreflangEn,
  hreflangEs,
} = Astro.props;

const isSpanish = lang === 'es';
const defaultDescription = isSpanish
  ? `Maxim Autos: autos usados completamente inspeccionados ${facts.inventory.bandTextEs} en Skokie, IL. Placas el mismo dia. Sin tramites del DMV. Financiamiento para todos los niveles de credito. Resenas de 5 estrellas en Google.`
  : 'Quality used cars in Skokie, IL. Every vehicle inspected, every price transparent. Metal plates on the spot. Skip the DMV. Financing for all credit levels. Maxim Autos.';
const resolvedDescription = description ?? defaultDescription;

const trust = isSpanish
  ? {
      heading: 'Por que confian en nosotros',
      protection: 'Inspeccionado y Documentado',
      protectionDetail: 'CARFAX Gratis',
      protectionHref: `${base}/es/sobre-nosotros`,
      skipDmv: 'Sin tramites del DMV',
      skipDmvDetail: 'Placas el mismo dia',
      pricing: 'Cero Cargos de Dealer',
      // Empty until maxseo signs a Spanish twin of "No doc fee"; the span is not rendered
      // when empty. "Sin cargos ocultos" claimed no hidden fees, broader than no doc fee (R1-16).
      pricingDetail: '',
      pricingHref: `${base}/es/financiamiento`,
    }
  : {
      heading: 'Why Buyers Trust Us',
      protection: 'Inspected & Documented',
      protectionDetail: 'Free CARFAX',
      protectionHref: `${base}/about`,
      skipDmv: 'Skip the DMV',
      skipDmvDetail: 'Metal plates issued the same visit.',
      pricing: 'No Dealer Fees Ever',
      pricingDetail: 'No doc fee',
      pricingHref: `${base}/financing`,
    };

const siteName = 'Maxim Autos';
// Dedupe: if title already contains siteName, don't append it again
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;

// MIRROR CONTAINMENT.
// The same source builds twice: production on Vercel at www.maximautos.com, and a
// GitHub Pages mirror at dexmang.github.io/MaximAutosWeb (astro.config.mjs switches on
// VERCEL). Verified live 2026-07-26: the mirror served a 93 KB byte similar homepage with
// a canonical pointing AT ITSELF and no robots meta, so the entire site existed twice as
// an indexable duplicate. On a site where 28 pages already sit in Search Console as
// "Discovered, currently not indexed", a second full copy competes for the same crawl
// budget it cannot afford.
//
// Two signals, deliberately belt and braces:
//   1. canonical points at PRODUCTION, not at the mirror
//   2. noindex on every mirror page (see the robots meta below)
// deploy.yml also overwrites the mirror's robots.txt with Disallow: /
const PRODUCTION_ORIGIN = 'https://www.maximautos.com';
const isMirror = process.env.VERCEL !== '1' && process.env.MAXIM_LOCAL_DEV !== '1';

// Build canonical and OG image as absolute URLs using Astro.site (from astro.config.mjs)
// so they always match the configured canonical domain regardless of inbound host
const siteUrl = Astro.site ?? new URL('https://www.maximautos.com/');
// On the mirror, strip the /MaximAutosWeb base and point at production, so even if the
// noindex is somehow missed the duplicate still consolidates to the real page.
const canonical = canonicalUrl || (
  isMirror
    ? PRODUCTION_ORIGIN + Astro.url.pathname.replace(/^\/MaximAutosWeb/, '')
    : new URL(Astro.url.pathname, siteUrl).href
);
const ogImageAbsolute = new URL(ogImage ?? `${base}/brand/hero-family.jpg`, siteUrl).href;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={resolvedDescription} />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>

    <link rel="canonical" href={canonical} />

    <!-- Favicons (full asset set) -->
    <link rel="icon" type="image/x-icon" href={`${base}/favicon.ico`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}/favicon-16x16.png`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="48x48" href={`${base}/favicon-48x48.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <meta name="theme-color" content="#f08010" />
    <meta name="msapplication-TileColor" content="#f08010" />
    <meta name="msapplication-TileImage" content={`${base}/mstile-150x150.png`} />

    <!-- hreflang alternate links for i18n -->
    {hreflangEn && <link rel="alternate" hreflang="en" href={hreflangEn} />}
    {hreflangEs && <link rel="alternate" hreflang="es" href={hreflangEs} />}
    {hreflangEn && hreflangEs && <link rel="alternate" hreflang="x-default" href={hreflangEn} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:url" content={canonical} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@MaximAutosSkokie" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <!-- Material Symbols -->
    <style is:inline>
      .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
      }
    </style>

    <!-- Organization schema, emitted on every page so SERP/knowledge-panel logo signal is universal -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Maxim Autos",
      "url": "https://www.maximautos.com",
      "logo": "https://www.maximautos.com/brand/logo-512.png",
      "sameAs": [
        "https://www.facebook.com/p/Maxim-Autos-61584813440976/",
        "https://www.cargurus.com/Cars/m-Maxim-Autos-sp457703",
        "https://www.cars.com/dealers/6072153/maxim-autos/"
      ]
    })} />

    <!-- Structured Data Slot -->
    <slot name="structured-data" />

    <!-- Sold vehicle pages: keep URL live but exclude from search index -->
    {noIndex && !isMirror && <meta name="robots" content="noindex, follow" />}
    {/* Mirror pages are noindex AND nofollow: there is nothing on the GitHub Pages copy
        worth crawling that production does not already serve. See the isMirror note above. */}
    {isMirror && <meta name="robots" content="noindex, nofollow" />}

    <!-- Google Search Console Verification -->
    <!-- TODO: Add meta name="google-site-verification" content="YOUR_VERIFICATION_CODE" here -->

    <!-- Google Analytics 4, Measurement ID: G-H05CD3EHE9 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-H05CD3EHE9"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-H05CD3EHE9');
    </script>

    <!-- GA4 lead events: tel:/sms: clicks, lead form submits, chat (future).
         Capture phase so AJAX forms (preventDefault in bubble phase) and
         dynamically rendered links are still counted.
         Every generate_lead carries cta_location (the nearest data-cta, else "body";
         "form" when a form handler calls maximLead), page_type and, on a vehicle page,
         vehicle_stock. Any other link with data-cta-name sends cta_click (D2-25).
         No value or currency: what a lead is worth is unverified (A2 4.2). -->
    <script is:inline define:vars={{ base }}>
      (function () {
        // Path without the mirror base and without a trailing slash: "/", "/es",
        // "/inventory", "/vehicle/2019-honda-cr-v-ex-j10246".
        var path = window.location.pathname;
        if (base && path.indexOf(base) === 0) path = path.slice(base.length);
        path = path.replace(/\/+$/, '') || '/';
        var pageType = (path === '/' || path === '/es') ? 'home'
          : (path === '/inventory' || path === '/es/inventario') ? 'inventory'
          : path.indexOf('/vehicle/') === 0 ? 'vdp'
          : 'other';
        // The stock number is the slug suffix (-j10246). It names a car, not a person.
        var stockMatch = pageType === 'vdp' ? path.match(/-(j\d{5})$/i) : null;
        var vehicleStock = stockMatch ? stockMatch[1].toUpperCase() : '';
        function params(extra) {
          var p = { page_type: pageType, transport_type: 'beacon' };
          if (vehicleStock) p.vehicle_stock = vehicleStock;
          for (var k in extra) p[k] = extra[k];
          return p;
        }
        function ctaLocation(a) {
          var el = a.closest('[data-cta]');
          return (el && el.getAttribute('data-cta')) || 'body';
        }
        // One generate_lead per channel plus location per page load: a double tap on
        // the sticky Call cell is one lead, not two.
        var sent = {};
        function lead(channel, loc) {
          if (typeof gtag !== 'function') return;
          var key = channel + '|' + loc;
          if (sent[key]) return;
          sent[key] = true;
          gtag('event', 'generate_lead', params({ lead_channel: channel, cta_location: loc }));
        }
        document.addEventListener('click', function (e) {
          var t = e.target;
          if (!t || typeof t.closest !== 'function') return;
          var a = t.closest('a[href^="tel:"], a[href^="sms:"]');
          if (a) {
            lead(a.getAttribute('href').indexOf('sms:') === 0 ? 'sms' : 'phone', ctaLocation(a));
            return;
          }
          // Taps that are not leads but are worth counting: carfax, google_reviews,
          // prequalify, directions.
          var c = t.closest('a[data-cta-name]');
          if (c && typeof gtag === 'function') {
            gtag('event', 'cta_click', params({ cta_name: c.getAttribute('data-cta-name'), cta_location: ctaLocation(c) }));
          }
        }, true);
        // Forms report their OWN success. The previous version listened for `submit` in
        // the capture phase, which runs BEFORE each page's handler calls preventDefault()
        // and fetch(), so generate_lead fired on every submit ATTEMPT: validation
        // failures, network errors, Formspree 500s, everything. Every conversion number
        // measured before 2026-07-26 counted clicks, not leads.
        //
        // Each form handler now calls window.maximLead('<channel>') inside its
        // `if (res.ok)` branch only. Channels: contact_form, financing_form, credit_app,
        // sell_trade_form, sms, phone, chat. It still takes one argument; the location
        // is always "form".
        window.maximLead = function (channel) { lead(channel, 'form'); };
        // Tawk.to is NOT installed today; this is a defensive no op hook so
        // chat leads start counting automatically if it ever gets added.
        window.Tawk_API = window.Tawk_API || {};
        window.Tawk_API.onChatStarted = function () { lead('chat', 'chat'); };
      })();
    </script>
  </head>
  <body class="bg-surface font-body text-gray-900 antialiased">
    <slot name="header" />

    <!-- Differentiator strip, every page. Fee first; the Google rating lives in the pinned
         header chip. Navy on orange is 5.77:1. The lg row keeps the live flex-wrap (R2-02). -->
    <div class="bg-orange text-navy">
      <div class="max-w-7xl mx-auto px-4">
        <TrustPair variant="strip" lang={lang} class="lg:hidden" />
        <div class="hidden lg:flex flex-wrap items-center gap-x-3 gap-y-1 py-2 text-xs">
          <span class="font-bold uppercase tracking-widest">{trust.heading}</span>
          <span class="opacity-40" aria-hidden="true">|</span>
          <a href={trust.pricingHref} class="flex items-center gap-1 hover:underline">
            <Icon name="sell" class="text-sm" fill />
            <span class="font-bold">{trust.pricing}</span>
            {trust.pricingDetail && <span class="hidden xl:inline font-medium">· {trust.pricingDetail}</span>}
          </a>
          <span class="opacity-40" aria-hidden="true">·</span>
          <a href={trust.protectionHref} class="flex items-center gap-1 hover:underline">
            <Icon name="gpp_good" class="text-sm" fill />
            <span class="font-bold">{trust.protection}</span>
            <span class="hidden xl:inline font-medium">· {trust.protectionDetail}</span>
          </a>
          <span class="opacity-40" aria-hidden="true">·</span>
          <div class="flex items-center gap-1">
            <Icon name="directions_car" class="text-sm" fill />
            <span class="font-bold">{trust.skipDmv}</span>
            <span class="hidden xl:inline font-medium">· {trust.skipDmvDetail}</span>
          </div>
        </div>
      </div>
    </div>

    <main>
      <slot />
    </main>
    <slot name="footer" />

    <!-- GHL Chat Widget (disabled) -->
    <!-- <script src="https://widgets.leadconnectorhq.com/loader.js" data-resources-url="https://widgets.leadconnectorhq.com/chat-widget/loader.js" data-widget-id="6a26cef49372a70f7d2c31e3" data-source="WEB_USER"></script> -->
  </body>
</html>
